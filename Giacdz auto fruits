-- [[ 5. HÀM HOP SERVER (Bypass Lỗi) ]]
local function HopServer()
    task.spawn(function()
        while task.wait(0.1) do GuiService:ClearError() end
    end)

    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local function ListServers(cursor)
        local success, Raw = pcall(function() return game:HttpGet(Api .. ((cursor and "&cursor=" .. cursor) or "")) end)
        return success and Http:JSONDecode(Raw) or nil
    end

    local Server = ListServers()
    if Server and Server.data then
        for _, v in pairs(Server.data) do
            if v.playing < v.maxPlayers and v.id ~= game.JobId then
                TPS:TeleportToPlaceInstance(game.PlaceId, v.id, LP)
                task.wait(1)
            end
        end
    end
    TPS:Teleport(game.PlaceId)
end

