                    ["description"] = "👤 Account: ||**" .. LP.Name .. "**||\n🍎 Fruit: **" .. fruitName .. "**\n Server ID: " .. game.JobId,
                    ["color"] = 65280,
                    ["footer"] = {["text"] = "Giacdz auto fruit - " .. os.date("%X")}
                }}
