                    ["description"] = "👤 Account: ||**" .. LP.Name .. "**||\n🍎 Fruit: **" .. fruitName .. "**\n🆔 Server ID: " .. game.JobId,
                    ["color"] = 65280,
                    ["footer"] = {["text"] = "Giacdz auto fruit - " .. os.date("%X")}
                }}
            }
            local body = Http:JSONEncode(data)
            local request = syn and syn.request or http_request or request or HttpPost
            if request then
                request({Url = getgenv().Webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = body})
