local function GetFruitInfo(fruitName)
    local cleanName = string.gsub(fruitName, " Fruit", "")
    for name, data in pairs(FruitRarities) do
        if string.find(cleanName, name) then
            return data.Color, data.Rarity, cleanName
        end
    end
    return 65280, "Unknown ❓", cleanName 
end

