end)

-- [[ HỆ THỐNG TWEEN & TÌM TRÁI ]]
local function GetDroppedFruit()
    for _, v in pairs(game.Workspace:GetChildren()) do
        if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
            return v.Handle 
        end
    end
    return nil
end

local function topos(targetCFrame)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local targetPos = targetCFrame.Position
    local directDist = (targetPos - root.Position).Magnitude

    if _G.CurrentTween and _G.LastTargetPos and (targetPos - _G.LastTargetPos.Position).Magnitude < 5 then 
        return 
    end
    
    if _G.CurrentTween then _G.CurrentTween:Cancel() end

    _G.LastTargetPos = targetCFrame
    
    -- TỐC ĐỘ ĐÃ CHỈNH LÀ 200
    local speed = 200 
    local info = TweenInfo.new(directDist / speed, Enum.EasingStyle.Linear)
    
    _G.CurrentTween = TweenService:Create(root, info, {CFrame = targetCFrame})
    _G.CurrentTween.Completed:Connect(function() 
        _G.LastTargetPos = nil
        _G.CurrentTween = nil 
    end)
    _G.CurrentTween:Play()
end

RunService.Stepped:Connect(function()
    pcall(function()
        if _G.CurrentTween and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            LP.Character.HumanoidRootPart.Velocity = Vector3.zero
            for _, v in pairs(LP.Character:GetChildren()) do 
                if v:IsA("BasePart") then v.CanCollide = false end 
            end
        end
    end)
end)

