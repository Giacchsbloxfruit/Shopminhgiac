-- [[ 5. HÀM HOP SERVER (FIX REJOIN) ]]
local function HopServer()
    task.spawn(function()
        while task.wait(0.1) do GuiService:ClearError() end
    end)

    -- Lấy danh sách server đông (Desc)
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
    
    local function ListServers(cursor)
        local success, Raw = pcall(function() return game:HttpGet(Api .. ((cursor and "&cursor=" .. cursor) or "")) end)
        return success and Http:JSONDecode(Raw) or nil
    end

    local Server = ListServers()
    if Server and Server.data then
        local ValidServers = {}
        for _, v in pairs(Server.data) do
            if type(v) == "table" and v.playing < v.maxPlayers then
                -- KIỂM TRA BLACKLIST: Nếu ID server nằm trong danh sách cũ thì bỏ qua
                local isBlacklisted = false
                for _, blackId in pairs(shared.BlacklistServer) do
                    if v.id == blackId then
                        isBlacklisted = true
                        break
                    end
                end
                
                if not isBlacklisted then
                    table.insert(ValidServers, v.id)
                end
            end
        end

        if #ValidServers > 0 then
            -- Chọn server bất kỳ trừ server cũ
            local TargetId = ValidServers[math.random(1, #ValidServers)]
            TPS:TeleportToPlaceInstance(game.PlaceId, TargetId, LP)
        else
            -- Nếu tất cả server trong list đều bị blacklist, thử nhảy đại sang server bất kỳ
            TPS:Teleport(game.PlaceId)
        end
    end
end

