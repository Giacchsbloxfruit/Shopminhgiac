-- ========================================================
-- [[ 4. HÀM CẤT KHO & MUA CHIP (LOGIC MỚI KHÔNG XUNG ĐỘT) ]]
-- ========================================================
task.spawn(function()
    while task.wait(1) do
        if _G.AutoFarmRaid and not LP.PlayerGui.Main.Timer.Visible and not workspace._WorldOrigin.Locations:FindFirstChild("Island 1") then
            pcall(function()
                local hasChip = LP.Backpack:FindFirstChild("Special Microchip") or LP.Character:FindFirstChild("Special Microchip")
                
                if not hasChip then
                    -- Tìm trái trong túi
                    local fruitInBag = nil
                    for _, v in pairs(LP.Backpack:GetChildren()) do
                        if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit")) then
                            fruitInBag = v
                            break
                        end
                    end

                    if fruitInBag then
                        -- Lấy trái ra tay
                        LP.Character.Humanoid:EquipTool(fruitInBag)
                        task.wait(0.5)
                        
                        -- Thực hiện cất kho
                        local fruitName = fruitInBag.Name:gsub(" Fruit", "")
                        GetCommF():InvokeServer("StoreFruit", fruitName, fruitInBag)
                        task.wait(1) -- Đợi server phản hồi
                        
                        -- Kiểm tra: Nếu sau khi cất mà trái vẫn CÒN TRÊN TAY (Rương đầy) -> Mua Chip
                        local toolOnHand = LP.Character:FindFirstChildOfClass("Tool")
                        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
                            GetCommF():InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                            task.wait(1)
                        end
                    else
                        -- Không có trái trong túi -> Kiểm tra xem có trái ngoài đất không
                        local groundFruit = false
                        for _, v in pairs(workspace:GetChildren()) do
                            if string.find(v.Name, "Fruit") and v:IsA("Tool") then groundFruit = true break end
                        end
                        -- Không có trái nào cả -> Hop Server
                        if not groundFruit then
                            local Http = game:GetService("HttpService")
                            local TPS = game:GetService("TeleportService")
                            local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
                            local Raw = game:HttpGet(Api)
                            local Decode = Http:JSONDecode(Raw)
                            for _, s in pairs(Decode.data) do
                                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                                    TPS:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                    break
                                end
                            end
                        end
                    end
                else
                    -- ĐÃ CÓ CHIP -> TIẾN HÀNH ĐI RAID
                    if game.PlaceId == 7449423635 then -- Sea 3
                        GetCommF():InvokeServer("requestEntrance", Vector3.new(-5075.5, 314.51, -3150.02))
                        task.wait(0.5)
                        LP.Character.HumanoidRootPart.CFrame = CFrame.new(-5017.4, 314.84, -2823.01)
                        task.wait(0.5)
                        fireclickdetector(workspace.Map["Boat Castle"].RaidSummon2.Button.Main.ClickDetector)
                    elseif game.PlaceId == 4442272183 then -- Sea 2
                        LP.Character.HumanoidRootPart.CFrame = CFrame.new(-6438.73, 250.64, -4501.5)
                        task.wait(0.5)
                        fireclickdetector(workspace.Map.CircleIsland.RaidSummon2.Button.Main.ClickDetector)
                    end
                end
            end)
        end
    end
end)

-- ========================================================
-- [[ 5. LOGIC TRẬN RAID (COMPLETE RAID) ]]
-- ========================================================
local function topos(Pos)
    pcall(function()
        local root = LP.Character.HumanoidRootPart
        local dist = (Pos.Position - root.Position).Magnitude
        local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
        bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
        TS:Create(root, TweenInfo.new(dist/250, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

task.spawn(function()
    while task.wait() do
        if _G.AutoFarmRaid and LP.PlayerGui.Main.Timer.Visible then
            pcall(function()
                local enemies = workspace.Enemies:GetChildren()
                if #enemies > 0 then
                    for _, mob in pairs(enemies) do
                        if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                            topos(mob.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                            RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                            RS.Modules.Net["RE/RegisterHit"]:FireServer(mob.PrimaryPart, {{mob, mob.PrimaryPart}})
                        end
                    end
                else
                    -- Không còn quái, bay tìm đảo tiếp theo
                    for i = 5, 1, -1 do
                        local island = workspace._WorldOrigin.Locations:FindFirstChild("Island " .. i)
                        if island and (island.Position - LP.Character.HumanoidRootPart.Position).Magnitude <= 4000 then
                            topos(island.CFrame * CFrame.new(0, 80, 0))
                            break
                        end
                    end
                end
            end)
        end
    end
end)

