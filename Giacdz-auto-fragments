local LP = game.Players.LocalPlayer
local TS = game:GetService("TweenService")
local Remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("CommF_")

-- [[ 1. HÀM TWEEN CHỐNG BAN (TỐC ĐỘ 200) - DÙNG ĐỂ ĐÁNH QUÁI ]]
local function topos_tween(Pos)
    pcall(function()
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        
        local Distance = (Pos.Position - Root.Position).Magnitude
        if Distance < 5 then Root.CFrame = Pos return end 

        local Speed = 200 
        local Time = Distance / Speed
        
        if not Root:FindFirstChild("DungeonBV") then
            local bv = Instance.new("BodyVelocity")
            bv.Name = "DungeonBV"
            bv.Velocity = Vector3.new(0,0,0)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Parent = Root
        end
        
        local tween = TS:Create(Root, TweenInfo.new(Time, Enum.EasingStyle.Linear), {CFrame = Pos})
        tween:Play()
    end)
end

-- [[ 2. HÀM TELEPORT (ÉP TỌA ĐỘ) - DÙNG ĐỂ START RAID NHANH ]]
local function topos_fast(Pos)
    pcall(function()
        if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            LP.Character.HumanoidRootPart.CFrame = Pos
        end
    end)
end

-- [[ 3. HÀM TÌM ĐẢO RAID ]]
local function GetCurrentIsland()
    local locations = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if not locations then return nil end
    for i = 5, 1, -1 do
        local island = locations:FindFirstChild("Island " .. i)
        if island then return island end
    end
    return nil
end

-- [[ 4. HÀM TRANG BỊ VŨ KHÍ ]]
local function EquipWeapon(toolName)
    pcall(function()
        if LP.Character:FindFirstChildOfClass("Tool") then return end
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == toolName or v.Name == toolName or (toolName == "Melee" and v.ToolTip == "Melee")) then
                LP.Character.Humanoid:EquipTool(v)
                break
            end
        end
    end)
end

