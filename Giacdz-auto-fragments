-- [[ THÔNG BÁO ]]
local function Notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Giacdz Hub",
            Text = text,
            Duration = 3
        })
    end)
end

-- [[ KIỂM TRA TÚI & TAY ]]
local function CheckFull()
    local has = false
    if not LP.Character then return false end
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit") or v.Name == "Special Microchip") then has = true end
    end
    for _, v in pairs(LP.Character:GetChildren()) do
        if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit") or v.Name == "Special Microchip") then has = true end
    end
    return has
end

-- [[ TWEEN 170 ]]
local function topos_tween(Pos)
    pcall(function()
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        local Distance = (Pos.Position - Root.Position).Magnitude
        if Distance < 5 then 
            if Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
            return 
        end 
        if not Root:FindFirstChild("DungeonBV") then
            local bv = Instance.new("BodyVelocity", Root)
            bv.Name = "DungeonBV"; bv.MaxForce = Vector3.new(9e9, 9e9, 9e9); bv.Velocity = Vector3.new(0,0,0)
        end
        TS:Create(Root, TweenInfo.new(Distance/_G.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

-- [[ 2. HÀM ÉP LỆNH CẤT KHO (NGUYÊN BẢN 100%) ]]
local function StoreAction()
    pcall(function()
        local inRaid = LP.PlayerGui.Main.Timer.Visible or (workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations"):FindFirstChild("Island 1"))
        if inRaid then return end

        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local remote = GetCommF()
        
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                task.wait(0.2)
            end
        end

        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            task.defer(function()
                if remote then
                    remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", fruitName.."-"..fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", toolOnHand.Name, toolOnHand)
                end
            end)
            task.wait(1) 
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do StoreAction() end
end)

-- [[ 5. AUTO TELEPORT FRUITS (NGUYÊN BẢN 100%) ]]
task.spawn(function()
    while task.wait(0.1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible
        if _G.Grabfruit and not inRaid then
            pcall(function()
                for _, v in pairs(game.Workspace:GetChildren()) do
                    if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
                        LP.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                        LastGrabTime = tick()
                    end
                end
            end)
        end
    end
end)

-- [[ LOGIC AUTO CHECK & HOP (10s SAU KHI BẬT) ]]
task.spawn(function()
    local counter = 0
    Notify("Script đã chạy! Chờ 10s để hệ thống ổn định...")
    task.wait(10) -- Chờ 10 giây đầu tiên như bạn yêu cầu
    
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible
        if not inRaid then
            if CheckFull() then
                counter = 0
            else
                counter = counter + 1
                if counter == 5 then 
                    Notify("Túi trống (5s). Sẽ Hop sau 10s nữa.")
                elseif counter >= 15 then
                    Notify("Đang nhảy Server mới!")
                    pcall(function()
                        local servers = game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
                        for _, s in pairs(servers) do
                            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                                game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                break
                            end
                        end
                    end)
                    counter = 0
                end
            end
        else
            counter = 0
        end
    end
end)

-- [[ MUA CHIP & RAID ]]
task.spawn(function()
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible
        local hasChip = CheckFull()

        if not inRaid then
            if RaidEndTime == 0 then RaidEndTime = tick() end
            -- Mua chip đầu tiên cũng phải sau 10s bật script hoặc 5s sau khi nhặt trái
            local canBuy = (tick() - ScriptStartedTime > 10) and (tick() - LastGrabTime > 5) and (tick() - RaidEndTime > 5)

            if not hasChip and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
            end

            if (LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))) then
                topos_tween(CFrame.new(-6438.73, 250.64, -4501.5))
                if (LP.Character.HumanoidRootPart.Position - Vector3.new(-6438.73, 250.64, -4501.5)).Magnitude < 20 then
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then fireclickdetector(RaidBtn.ClickDetector) end
                end
            end
        else
            BoughtChip = false 
            RaidEndTime = tick()
        end
    end
end)

