-- [[ HÀM KIỂM TRA ĐANG TRONG RAID ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end end
    return nil
end

-- [[ 4. MUA CHIP & 5. START RAID (TỐI ƯU CHỐNG SPAM) ]]
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            
            if inRaid then 
                IsProcessingRaid = true 
            else
                -- Chỉ tiếp tục nếu đã kết thúc Raid trước đó và đã nhặt trái xong ít nhất 5 giây
                if (tick() - LastGrabTime) > 5 then
                    -- Mua Chip
                    if _G.AutoBuyChip and not hasChip then
                        Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                        task.wait(1)
                    end
                    
                    -- Start Raid (Dùng Tween)
                    if _G.StartRaid and hasChip then
                        local Sea2_RaidPos = CFrame.new(-6438.73, 250.64, -4501.5)
                        topos_tween(Sea2_RaidPos) -- Đổi sang Tween theo ý bạn
                        
                        -- Chờ bay tới nơi rồi mới bấm
                        if (LP.Character.HumanoidRootPart.Position - Sea2_RaidPos.Position).Magnitude < 15 then
                            task.wait(0.2)
                            Remote:InvokeServer("SetSpawnPoint")
                            local Button = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                            if Button then fireclickdetector(Button.ClickDetector) end
                        end
                    end
                end
                
                -- Sau khi thực hiện xong các bước ở sảnh, reset trạng thái
                if not inRaid and not hasChip then
                    IsProcessingRaid = false
                end
            end
        end)
    end
end)

-- [[ 6. COMPLETE RAID (KILL NEAREST) ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        local inRaid = LP.PlayerGui.Main.Timer.Visible or island
        
        if _G.Dungeon and inRaid then
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if island and (v.HumanoidRootPart.Position - island.Position).Magnitude < 800 then
                            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist = d; target = v end
                        end
                    end
                end
                if target then
                    if not LP.Character:FindFirstChildOfClass("Tool") then
                        for _, t in pairs(LP.Backpack:GetChildren()) do if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) end end
                    end
                    topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                elseif island then 
                    topos_tween(island.CFrame * CFrame.new(0, 60, 0)) 
                end
            end)
        end
    end
end)

-- [[ 7. HOP SERVER ]]
function HopServer()
    local PlaceId = game.PlaceId
    local Servers = game.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
    for _, v in pairs(Servers.data) do
        if v.playing < v.maxPlayers and v.id ~= game.JobId then
            game:GetService("TeleportService"):TeleportToPlaceInstance(PlaceId, v.id, LP)
            break
        end
    end
end

task.spawn(function()
    local waitTime = 30
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            local hasFruit = false
            for _, v in pairs(LP.Backpack:GetChildren()) do
                if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit")) then hasFruit = true break end
            end

            if not inRaid and not hasChip and not hasFruit then
                waitTime = waitTime - 1
                if waitTime % 10 == 0 or waitTime <= 5 then Notify("Server Hop in " .. waitTime .. "s") end
                if waitTime <= 0 then Notify("Hopping..."); HopServer(); waitTime = 30 end
            else
                waitTime = 30
            end
        end
    end
end)

