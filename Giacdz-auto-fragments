-- [[ 2. AUTO BUSO & CẦM VŨ KHÍ (FIXED) ]]
-- ========================================================
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            if _G.AutoFarmRaid and LP.Character and LP.Character:FindFirstChild("Humanoid") then
                -- Auto Haki
                if not LP.Character:FindFirstChild("HasBuso") then
                    GetCommF():InvokeServer("Buso")
                end
                
                -- Chỉ cầm Melee khi không cầm Trái Ác Quỷ để tránh làm gián đoạn cất kho/mua chip
                local tool = LP.Character:FindFirstChildOfClass("Tool")
                local hasFruitOnHand = tool and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit"))
                
                if not hasFruitOnHand then
                    for _, v in pairs(LP.Backpack:GetChildren()) do
                        if v:IsA("Tool") and (v.ToolTip == "Melee" or v.Name == "Combat" or v.Name == "Superhuman" or v.Name == "Godhuman" or v.Name == "Electric Claw" or v.Name == "Sharkman Karate") then
                            LP.Character.Humanoid:EquipTool(v)
                            break
                        end
                    end
                end
            end
        end)
    end
end)

