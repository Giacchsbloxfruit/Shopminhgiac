-- [[ 6. LOGIC KILL NEAREST RAID (TWEEN 200) ]]
task.spawn(function()
    while task.wait(0.1) do
        local inRaid = (LP.PlayerGui.Main:FindFirstChild("Timer") and LP.PlayerGui.Main.Timer.Visible) or GetCurrentIsland()
        
        if _G.Dungeon and inRaid then
            pcall(function()
                local targetIsland = GetCurrentIsland()
                local targetMob = nil
                local shortestDist = math.huge
                
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if targetIsland then
                            local distToIsland = (v.HumanoidRootPart.Position - targetIsland.Position).Magnitude
                            if distToIsland < 800 then
                                local distToMe = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                                if distToMe < shortestDist then
                                    shortestDist = distToMe
                                    targetMob = v
                                end
                            end
                        end
                    end
                end

                if targetMob then
                    EquipWeapon(_G.SelectWeapon)
                    topos_tween(targetMob.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                elseif targetIsland then
                    topos_tween(targetIsland.CFrame * CFrame.new(0, 60, 0))
                end
            end)
        end
    end
end)

