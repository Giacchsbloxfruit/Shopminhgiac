-- [[ 5. LOGIC MUA CHIP & HOP SERVER ]]
-- ========================================================
local function HopServer()
    local Http = game:GetService("HttpService")
    local TPS = game:GetService("TeleportService")
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
    
    local function GetNextServer()
        local Raw = game:HttpGet(Api)
        local Decode = Http:JSONDecode(Raw)
        if Decode and Decode.data then
            for _, s in pairs(Decode.data) do
                if s.playing and s.playing < s.maxPlayers and s.id ~= game.JobId then
                    return s.id
                end
            end
        end
        return nil
    end
    repeat
        task.wait(0.5)
        local ServerId = GetNextServer()
        if ServerId then
            pcall(function() TPS:TeleportToPlaceInstance(game.PlaceId, ServerId, LP) end)
        end
    until not LP 
end

