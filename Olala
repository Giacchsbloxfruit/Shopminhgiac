-- [[ 7. VÒNG LẶP FARM CHÍNH ]]
task.spawn(function()
    while task.wait() do
        pcall(function()
            local myLv = LP.Data.Level.Value
            local q = nil
            -- Tìm Quest phù hợp với Level hiện tại
            for _, v in pairs(QuestList) do
                if myLv >= v.Min and myLv <= v.Max then q = v break end
            end
            if not q then return end

            local QuestGui = LP.PlayerGui.Main.Quest
            if not QuestGui.Visible then
                TweenTo(q.NPC)
                if (LP.Character.HumanoidRootPart.Position - q.NPC.Position).Magnitude < 15 then
                    Remote:InvokeServer("StartQuest", q.Name, q.Lv)
                end
            else
                local Enemy = nil
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if (string.find(e.Name, q.Mon) or e.Name == q.Mon) and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                        Enemy = e break
                    end
                end

                if Enemy then
                    local tool = LP.Character:FindFirstChildWhichIsA("Tool") or LP.Backpack:FindFirstChildWhichIsA("Tool")
                    if tool and tool.Parent ~= LP.Character then LP.Character.Humanoid:EquipTool(tool) end
                    TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0))
                    RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                    RS.Modules.Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                else
                    TweenTo(q.MonPos) -- Đứng chờ tại bãi quái
                end
            end
        end)
    end
end)
