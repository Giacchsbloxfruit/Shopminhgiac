-- [[ 3. HÀM TRANG BỊ VŨ KHÍ & BẬT HAKI ]]
local function EquipAndHaki()
    pcall(function()
        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        -- 1. Trang bị Melee
        local tool = LP.Backpack:FindFirstChild(getgenv().WeaponType) or LP.Backpack:FindFirstChildOfClass("Tool")
        if tool and hum then
            hum:EquipTool(tool)
        end
        
        -- 2. Bật Haki (Buso) nếu chưa bật
        if not char:FindFirstChild("HasBuso") then
            Remote:InvokeServer("Buso")
        end
    end)
end

-- [[ 4. AUTO STATS (ƯU TIÊN MELEE > DEFENSE) ]]
task.spawn(function()
    local StatsToUpgrade = {Melee = {"Melee", "Strength", "Combat"}, Defense = {"Defense", "Health"}}
    while task.wait(0.6) do
        pcall(function()
            local Data = LP:FindFirstChild("Data") or LP:FindFirstChild("Stats")
            local Points = Data and (Data:FindFirstChild("StatsPoints") or Data:FindFirstChild("Points"))
            if Points and Points.Value > 0 then
                local curMelee = Data.Melee.Value
                if curMelee < getgenv().MaxStat then
                    for _, sName in pairs(StatsToUpgrade.Melee) do 
                        Remote:InvokeServer("AddPoint", sName, 1)
                        Remote:InvokeServer({"AddPoint", sName, 1}) 
                    end
                else
                    for _, sName in pairs(StatsToUpgrade.Defense) do 
                        Remote:InvokeServer("AddPoint", sName, 1)
                        Remote:InvokeServer({"AddPoint", sName, 1}) 
                    end
                end
            end
        end)
    end
end)

-- [[ 5. HÀM BAY TWEEN AN TOÀN ]]
local function TweenTo(Pos)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local dist = (Pos.Position - root.Position).Magnitude
    if dist < 5 then root.CFrame = Pos return end
    
    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
    bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
    TS:Create(root, TweenInfo.new(dist/getgenv().TweenSpeed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
end

