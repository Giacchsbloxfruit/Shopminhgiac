-- [[ 8. MỚI: TỰ ĐỘNG ĐỔI SERVER SAU 30 PHÚT ]]
task.spawn(function()
    local HopTime = 1800 -- 30 phút = 1800 giây
    while task.wait(1) do
        HopTime = HopTime - 1
        if HopTime <= 0 then
            print("Đang tìm server mới...")
            local Http = game:GetService("HttpService")
            local TPS = game:GetService("TeleportService")
            local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
            
            local function GetNextServer()
                local Raw = game:HttpGet(Api)
                local Decode = Http:JSONDecode(Raw)
                for _, s in pairs(Decode.data) do
                    if s.playing < s.maxTokens and s.id ~= game.JobId then
                        return s.id
                    end
                end
            end

            local ServerId = GetNextServer()
            if ServerId then
                TPS:TeleportToPlaceInstance(game.PlaceId, ServerId, LP)
            end
            HopTime = 30 -- Reset chờ nếu không tìm thấy ngay
        end
    end
end)

