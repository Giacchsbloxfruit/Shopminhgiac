local function GetMeleeData()
    local name, mas = "", 0
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == "Melee" then
            name = v.Name
            if v:FindFirstChild("Level") then mas = v.Level.Value end
        end
    end
    for _, v in pairs(LP.Character:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == "Melee" then
            name = v.Name
            if v:FindFirstChild("Level") then mas = v.Level.Value end
        end
    end
    return name, mas
end

