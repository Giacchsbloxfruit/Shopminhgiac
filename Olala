                end
            else
                local Enemy = nil
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    -- Tìm theo tên hoặc khoảng cách bãi (Phòng khi sai tên)
                    if (string.find(e.Name, q.Mon) or (e:GetModelCFrame().Position - q.MonPos.Position).Magnitude < 100) and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                        Enemy = e break
