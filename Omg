        pcall(function()
            -- Ưu tiên nhặt trái ác quỷ
            if _G.Grabfruit then
                for _, v in pairs(workspace:GetChildren()) do
                    if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
                        LP.Character.HumanoidRootPart.CFrame = v.Handle.CFrame; return 
                    end
                end
            end
            
            CheckQuest()

            -- LOGIC KIỂM TRA NHIỆM VỤ TỪ CODE CŨ
            if not LP.PlayerGui.Main.Quest.Visible then
                TweenTo(CFrameQuest)
                if (LP.Character.HumanoidRootPart.Position - CFrameQuest.Position).Magnitude < 15 then
                    GetCommF():InvokeServer("StartQuest", NameQuest, LevelQuest)
                    task.wait(0.5) -- Thêm chút nghỉ để server nhận Quest
                end
            else
                local Enemy = nil
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if (string.find(e.Name, NameMon) or e.Name == NameMon) and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                        Enemy = e; break
                    end
                end
                
                if Enemy then
                    EquipMelee()
                    -- Bay lên đầu quái để né skill (Logic cũ: y + 25)
                    TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0))
                    RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                    RS.Modules.Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                else
                    TweenTo(CFrameMon) -- Nếu chưa có quái thì bay ra điểm spawn quái
                end
            end
        end)
    end
end)

