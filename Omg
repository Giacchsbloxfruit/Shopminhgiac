-- [[ 3. HÀM THÔNG BÁO DISCORD (CHỐNG SPAM) ]]
local function SendDiscordNotification(fruitName, status)
    if getgenv().LastStoredFruit == fruitName then return end 
    
    local url = getgenv().WebhookURL
    local data = {
        ["content"] = "",
        ["embeds"] = {{
            ["title"] = "🚀 **ĐÃ LỤM ĐC FRUIT**",
            ["description"] = "👤 **Tài khoản**: " .. LP.Name .. "\n🍎 **Trái**: " .. fruitName .. "\n✅ **Trạng thái**: " .. status,
            ["color"] = status == "Balo đầy" and 16711680 or 65280, 
            ["footer"] = { ["text"] = "Gemini Blox Fruit Script • " .. os.date("%X") }
        }}
    }
    local request = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if request then
        request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = game:GetService("HttpService"):JSONEncode(data)
        })
        getgenv().LastStoredFruit = fruitName
        task.delay(15, function() getgenv().LastStoredFruit = "" end) -- Reset sau 15s để có thể nhận trái cùng loại tiếp theo
    end
end

-- [[ 4. HÀM ÉP LỆNH CẤT KHO ]]
local function StoreAction()
    pcall(function()
        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local remote = GetCommF()
        
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                task.wait(0.2)
            end
        end

        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            task.defer(function()
                if remote then
                    local success = remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
                    if success then
                        SendDiscordNotification(toolOnHand.Name, "Đã cất vào balo")
                    else
                        SendDiscordNotification(toolOnHand.Name, "Balo đầy")
                    end
                end
            end)
        end
    end)
end

task.spawn(function()
