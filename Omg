-- [[ 2. HÀM HỖ TRỢ HỆ THỐNG ]] --
local function GetCommF() return RS:FindFirstChild("CommF_", true) end

local function GetAC()
    local s, r = pcall(function() return require(RS:WaitForChild("Controllers"):WaitForChild("CombatController")).activeController end)
    return s and r or nil
end

local function TweenTo(Pos, Speed)
    pcall(function()
        local root = LP.Character:WaitForChild("HumanoidRootPart")
        local dist = (Pos.Position - root.Position).Magnitude
        local s = Speed or getgenv().TweenSpeed
        if dist < 5 then root.CFrame = Pos return end
        if not root:FindFirstChild("AntiFall") then
            local bv = Instance.new("BodyVelocity", root)
            bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
        end
        TS:Create(root, TweenInfo.new(dist/s, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

