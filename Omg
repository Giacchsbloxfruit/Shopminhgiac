local function AutoRotateMelee()
    pcall(function()
        local tool = LP.Backpack:FindFirstChildOfClass("Tool") or LP.Character:FindFirstChildOfClass("Tool")
        if tool and tool.ToolTip == "Melee" then
            local mastery = 0
            if tool:FindFirstChild("Level") then mastery = tool.Level.Value end
            
            if mastery >= getgenv().MasteryLimit then
                local nextMelee = ""
                if tool.Name == "Dark Step" then nextMelee = "Electric"
                elseif tool.Name == "Electric" then nextMelee = "Water Kung Fu"
                elseif tool.Name == "Water Kung Fu" then nextMelee = "Dragon Breath" end
                
                if nextMelee ~= "" and MeleeList[nextMelee] then
                    local info = MeleeList[nextMelee]
                    TweenTo(info.Pos, getgenv().TweenSpeed)
                    if (LP.Character.HumanoidRootPart.Position - info.Pos.Position).Magnitude < 15 then
                        GetCommF():InvokeServer(unpack(info.Args))
                    end
                end
            end
        end
    end)
end

