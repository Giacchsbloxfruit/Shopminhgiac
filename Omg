local function TweenTo(Pos, Speed)
    local root = LP.Character:WaitForChild("HumanoidRootPart")
    local dist = (Pos.Position - root.Position).Magnitude
    if dist < 5 then root.CFrame = Pos return end
    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
    game:GetService("TweenService"):Create(root, TweenInfo.new(dist/Speed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
end

