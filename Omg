local function SendDiscordNotification(fruitName)
    local data = {
        ["content"] = "🚀 **THÔNG BÁO HỆ THỐNG KHO ĐỒ**",
        ["embeds"] = {{
            ["title"] = "📦 ĐÃ TỰ ĐỘNG CẤT TRÁI VÀO KHO!",
            ["description"] = "👤 Tài khoản: **" .. LP.Name .. "**\n🎁 Trái ác quỷ: **" .. fruitName .. "**\n✅ Trạng thái: **Đã ép lệnh cất kho thành công!**",
            ["color"] = 3447003,
            ["footer"] = { ["text"] = "Gemini Blox Fruit Script • " .. os.date("%X") }
        }}
    }
    local request = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if request then
        request({Url = getgenv().WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = game:GetService("HttpService"):JSONEncode(data)})
    end
end

local function StoreAction()
    pcall(function()
        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                task.wait(0.2)
            end
        end
        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            task.defer(function()
                Remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
            end)
            SendDiscordNotification(toolOnHand.Name)
            task.wait(1)
        end
    end)
end

