-- [[ HÀM BAY (TWEEN) TỐI ƯU ]]
local CurrentTween = nil
local function TweenTo(Pos)
    local char = LP.Character or LP.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    
    if CurrentTween then CurrentTween:Cancel() end
    
    local dist = (Pos.Position - root.Position).Magnitude
    if dist < 5 then root.CFrame = Pos return end

    -- Tạo BodyVelocity để chống rơi/rung
    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
    bv.Name = "AntiFall"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero

    CurrentTween = TS:Create(root, TweenInfo.new(dist/getgenv().Config.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = Pos})
    CurrentTween:Play()
end

