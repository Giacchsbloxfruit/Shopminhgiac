-- [[ 6. LOOP FARM CHÍNH ]] --
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local myLv = LP.Data.Level.Value
            local q = nil
            -- Tìm quest phù hợp với cấp độ
            for _, v in pairs(QuestList) do 
                if myLv >= v.Min and myLv <= v.Max then 
                    q = v 
                    break 
                end 
            end
            
            if q then
                -- Nếu chưa nhận quest thì đi nhận
                if not LP.PlayerGui.Main.Quest.Visible then
                    TweenTo(q.NPC)
                    if (LP.Character.HumanoidRootPart.Position - q.NPC.Position).Magnitude < 15 then
                        GetCommF():InvokeServer("StartQuest", q.Name, q.Lv)
                    end
                else
                    -- Đã có quest, tìm quái để farm
                    local Enemy = nil
                    for _,v in pairs(workspace.Enemies:GetChildren()) do
                        if v.Name == q.Mon or v.Name == q.Mon.." [Lv. "..q.Lv.."]" then
                            if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                                Enemy = v
                                break
                            end
                        end
                    end

                    if Enemy then
                        -- Cầm vũ khí lên để Gravity Hub hoạt động
                        for _, v in pairs(LP.Backpack:GetChildren()) do 
                            if v.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(v) end 
                        end
                        -- Bay lên đầu quái để Hub tự đánh
                        TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                    else
                        -- Không thấy quái thì bay về bãi quái
                        TweenTo(q.MonPos)
                    end
                end
            end
        end)
    end
end)

