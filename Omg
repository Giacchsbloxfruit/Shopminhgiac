-- [[ 6. HÀM HỖ TRỢ FARM ]]
local function TweenTo(Pos, Speed)
    local char = LP.Character or LP.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local dist = (Pos.Position - root.Position).Magnitude
    if dist < 5 then root.CFrame = Pos return end
    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
    bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
    TS:Create(root, TweenInfo.new(dist/Speed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
end

local function EquipMelee()
    pcall(function()
        local char = LP.Character
        if not char:FindFirstChild("HasBuso") then 
            local remote = GetCommF()
            if remote then remote:InvokeServer("Buso") end
        end
        if not char:FindFirstChildOfClass("Tool") then
            for _, v in pairs(LP.Backpack:GetChildren()) do
                if v:IsA("Tool") and (v.ToolTip == "Melee" or v.Name == "Combat" or v.Name == "Dark Step" or v.Name == "Electric" or v.Name == "Water Kung Fu") then
                    char.Humanoid:EquipTool(v) break
                end
            end
        end
    end)
end

-- [[ 7. FRUIT SNIPER (ĐI NHẶT TRÁI TRÊN ĐẤT) ]]
local function CheckFruitOnGround()
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Tool") or (v:IsA("Model") and string.find(v.Name, "Fruit")) then
            local handle = v:FindFirstChild("Handle") or v.PrimaryPart
            if handle then
                TweenTo(handle.CFrame, getgenv().FruitSpeed)
                if (LP.Character.HumanoidRootPart.Position - handle.Position).Magnitude < 10 then
                    if v:IsA("Model") then
                        firetouchinterest(LP.Character.HumanoidRootPart, handle, 0)
                        task.wait(0.1)
                        firetouchinterest(LP.Character.HumanoidRootPart, handle, 1)
                    end
                end
                return true
            end
        end
    end
    return false
end

-- [[ 8. VÒNG LẶP FARM CHÍNH ]]
task.spawn(function()
    while task.wait() do
        pcall(function()
            if CheckFruitOnGround() then return end
            
            local myLv = LP.Data.Level.Value
            local q = nil
            for _, v in pairs(QuestList) do if myLv >= v.Min and myLv <= v.Max then q = v break end end
            if not q then return end
            
            if not LP.PlayerGui.Main.Quest.Visible then
                TweenTo(q.NPC, getgenv().TweenSpeed)
                if (LP.Character.HumanoidRootPart.Position - q.NPC.Position).Magnitude < 15 then
                    local remote = GetCommF()
                    if remote then remote:InvokeServer("StartQuest", q.Name, q.Lv) end
                end
            else
                local Enemy = nil
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if (string.find(e.Name, q.Mon) or e.Name == q.Mon) and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                        Enemy = e break
                    end
                end
                if Enemy then
                    EquipMelee()
                    TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0), getgenv().TweenSpeed)
                    RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                    RS.Modules.Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                else
                    TweenTo(q.MonPos, getgenv().TweenSpeed)
                end
            end
        end)
    end
end)

