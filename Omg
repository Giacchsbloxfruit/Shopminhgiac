local function SendDiscordNotification(fruitName)
    local data = {
        ["content"] = "🚀 **THÔNG BÁO HỆ THỐNG KHO ĐỒ**",
        ["embeds"] = {{
            ["title"] = "📦 ĐÃ TỰ ĐỘNG CẤT TRÁI VÀO KHO!",
            ["description"] = "👤 Tài khoản: **" .. LP.Name .. "**\n🎁 Trái ác quỷ: **" .. fruitName .. "**",
            ["color"] = 3447003,
            ["footer"] = { ["text"] = "Gemini Blox Fruit Script • " .. os.date("%X") }
        }}
    }
    local req = (syn and syn.request) or (http and http.request) or http_request or request
    if req then req({Url = getgenv().WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = game:GetService("HttpService"):JSONEncode(data)}) end
end

local function StoreAction()
    pcall(function()
        local char = LP.Character
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == "Fruit" then
                char.Humanoid:EquipTool(tool)
                task.wait(0.3)
            end
        end
        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and toolOnHand.ToolTip == "Fruit" then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            Remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
            SendDiscordNotification(toolOnHand.Name)
        end
    end)
end

-- [[ 5. AUTO MUA MELEE ]]
local function AutoBuyMelee()
    local money = LP.Data.Belis.Value
    if not LP.Backpack:FindFirstChild("Dark Step") and not LP.Character:FindFirstChild("Dark Step") and money >= 150000 then
        Remote:InvokeServer("BuyDarkStep")
    elseif not LP.Backpack:FindFirstChild("Electric") and not LP.Character:FindFirstChild("Electric") and money >= 500000 then
        Remote:InvokeServer("BuyElectric")
    elseif not LP.Backpack:FindFirstChild("Water Kung Fu") and not LP.Character:FindFirstChild("Water Kung Fu") and money >= 750000 then
        Remote:InvokeServer("BuyWaterKungFu")
    end
end

-- [[ 6. TWEEN & EQUIP ]]
local function TweenTo(Pos, Speed)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local dist = (Pos.Position - root.Position).Magnitude
    if dist < 5 then root.CFrame = Pos return end
    
    if not root:FindFirstChild("AntiFall") then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
    end
    
    TS:Create(root, TweenInfo.new(dist/Speed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
end

local function EquipMelee()
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and (v.ToolTip == "Melee" or v.Name == "Combat") then
            LP.Character.Humanoid:EquipTool(v)
            break
        end
    end
end

