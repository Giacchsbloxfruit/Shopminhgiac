local function CheckQuest()
    local myLv = LP.Data.Level.Value
    for _, v in pairs(QuestList) do
        if myLv >= v.Min and myLv <= v.Max then
            NameQuest = v.Name
            LevelQuest = v.Lv
            NameMon = v.Mon
            CFrameQuest = v.NPC
            CFrameMon = v.MonPos
            return
        end
    end
    -- Mặc định nếu quá lv cao nhất
    NameQuest = "FountainQuest"; LevelQuest = 2; NameMon = "Galley Captain"
    CFrameQuest = CFrame.new(5258.1, 38.2, 4048.2); CFrameMon = CFrame.new(5660.4, 4.4, 4455.2)
end

local function EquipMelee()
    pcall(function()
        local char = LP.Character
        if not char:FindFirstChild("HasBuso") then GetCommF():InvokeServer("Buso") end
        if not char:FindFirstChildOfClass("Tool") then
            for _, v in pairs(LP.Backpack:GetChildren()) do
                if v:IsA("Tool") and (v.ToolTip == "Melee" or v.Name == "Combat" or v.Name == "Dark Step" or v.Name == "Electric" or v.Name == "Water Kung Fu") then
                    char.Humanoid:EquipTool(v); break
                end
            end
        end
    end)
end

