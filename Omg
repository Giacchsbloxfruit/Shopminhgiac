-- [ SỬA TWEEN: TỰ ĐỘNG XÓA ANTI-FALL KHI ĐẾN GẦN ]
local function TweenTo(targetPos)
    local char = LP.Character or LP.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local dist = (root.Position - targetPos.Position).Magnitude
    if dist > 12 then 
        local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
        bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
        TS:Create(root, TweenInfo.new(dist/getgenv().TweenSpeed, Enum.EasingStyle.Linear), {CFrame = targetPos}):Play()
        return false
    else
        if root:FindFirstChild("AntiFall") then root.AntiFall:Destroy() end
        return true
    end
end

