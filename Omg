local LastNotify = 0
local function SendDiscordNotification(fruitName, status)
    if tick() - LastNotify < 15 then return end 
    local data = {
        ["embeds"] = {{
            ["title"] = "🚀 **HỆ THỐNG QUẢN LÝ TRÁI CÂY**",
            ["description"] = "👤 **Tài khoản**: " .. LP.Name .. "\n🍎 **Trái**: " .. fruitName .. "\n✅ **Trạng thái**: " .. status,
            ["color"] = status:find("thành công") and 65280 or 16711680, 
            ["footer"] = { ["text"] = "Gemini Blox Fruit • " .. os.date("%X") }
        }}
    }
    pcall(function()
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        req({Url = getgenv().WebhookURL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode(data)})
        LastNotify = tick()
    end)
end

local function StoreAction()
    pcall(function()
        local char = LP.Character
        local remote = GetCommF()
        local fruit = nil
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit")) then fruit = v break end
        end
        if not fruit then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then fruit = tool end
        end
        if fruit then
            local fruitName = fruit.Name:gsub(" Fruit", "")
            if fruit.Parent == LP.Backpack then char.Humanoid:EquipTool(fruit) task.wait(0.2) end
            local success = remote:InvokeServer("StoreFruit", fruitName, fruit)
            if success then
                SendDiscordNotification(fruit.Name, "Đã cất vào kho thành công!")
            else
                task.wait(5) 
            end
        end
    end)
end

-- [[ 4. AUTO ROTATE MELEE (V1 -> 400 MAS) ]]
local MeleeList = {
    ["Dark Step"] = {Args = {"BuyDarkStep"}, Pos = CFrame.new(-1106, 14, 4308)},
    ["Electric"] = {Args = {"BuyElectric"}, Pos = CFrame.new(-1347, 37, -1325)},
    ["Water Kung Fu"] = {Args = {"BuyWaterKungFu"}, Pos = CFrame.new(61122, 18, 1565)},
    ["Dragon Breath"] = {Args = {"BlackbeardReward", "DragonBreath", "1"}, Pos = CFrame.new(-1100, 80, 1720)}
}

local function AutoRotateMelee()
    pcall(function()
        local tool = LP.Backpack:FindFirstChildOfClass("Tool") or LP.Character:FindFirstChildOfClass("Tool")
        if tool and tool.ToolTip == "Melee" then
            local mastery = 0
            if tool:FindFirstChild("Level") then mastery = tool.Level.Value end
            if mastery >= getgenv().MasteryLimit then
                local nextMelee = ""
                if tool.Name == "Dark Step" then nextMelee = "Electric"
                elseif tool.Name == "Electric" then nextMelee = "Water Kung Fu"
                elseif tool.Name == "Water Kung Fu" then nextMelee = "Dragon Breath" end
                if nextMelee ~= "" and MeleeList[nextMelee] then
                    local info = MeleeList[nextMelee]
                    TweenTo(info.Pos, getgenv().TweenSpeed)
                    if (LP.Character.HumanoidRootPart.Position - info.Pos.Position).Magnitude < 15 then
                        GetCommF():InvokeServer(unpack(info.Args))
                    end
                end
            end
        end
    end)
end

