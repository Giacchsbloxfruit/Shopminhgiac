task.spawn(function()
    while task.wait() do
        pcall(function()
            local myLv = LP.Data.Level.Value
            
            -- Logic chuyển Sea
            if PlaceId == 2753915549 and myLv >= 700 then
                local prog = GetCommF():InvokeServer("DressrosaQuestProgress", "Detective")
                if prog == "Detected" then
                    TweenTo(CFrame.new(-466, 47, 852), getgenv().TweenSpeed)
                    if (LP.Character.HumanoidRootPart.Position - Vector3.new(-466, 47, 852)).Magnitude < 10 then GetCommF():InvokeServer("TravelDressrosa") end
                else
                    TweenTo(CFrame.new(1347, 37, -1325), getgenv().TweenSpeed)
                end
                return
            end

            -- Tìm Quest
            local q = nil
            for _, v in pairs(QuestList) do if myLv >= v.Min and myLv <= v.Max then q = v break end end
            if not q then return end

            if not LP.PlayerGui.Main.Quest.Visible then
                TweenTo(q.NPC, getgenv().TweenSpeed)
                if (LP.Character.HumanoidRootPart.Position - q.NPC.Position).Magnitude < 15 then
                    GetCommF():InvokeServer("StartQuest", q.Name, q.Lv)
                end
            else
                local Enemy = nil
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if (string.find(e.Name, q.Mon) or e.Name == q.Mon) and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                        Enemy = e break
                    end
                end
                if Enemy then
                    EquipMelee(); TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0), getgenv().TweenSpeed)
                    RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                    RS.Modules.Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                else
                    TweenTo(q.MonPos, getgenv().TweenSpeed)
                end
            end
        end)
    end
end)

