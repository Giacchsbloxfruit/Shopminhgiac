-- [[ 2. HÀM HỖ TRỢ HỆ THỐNG ]] --
local function GetCommF() return RS:FindFirstChild("CommF_", true) end

local function TweenTo(Pos, Speed)
    pcall(function()
        if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
        local root = LP.Character.HumanoidRootPart
        local targetPos = (typeof(Pos) == "CFrame" and Pos.Position or Pos)
        local dist = (targetPos - root.Position).Magnitude
        local s = Speed or getgenv().TweenSpeed
        
        if dist < 10 then 
            root.CFrame = (typeof(Pos) == "CFrame" and Pos or CFrame.new(Pos))
            return 
        end
        
        if not root:FindFirstChild("AntiFall") then
            local bv = Instance.new("BodyVelocity", root)
            bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
        end
        
        local info = TweenInfo.new(dist/s, Enum.EasingStyle.Linear)
        TS:Create(root, info, {CFrame = (typeof(Pos) == "CFrame" and Pos or CFrame.new(Pos))}):Play()
    end)
end

