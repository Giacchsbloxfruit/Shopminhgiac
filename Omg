-- [[ 🚁 MODULE TWEEN & TELEPORT ]]
-- ========================================================
local function TweenTo(targetPos)
    if not LP.Character or not LP.Character:FindFirstChild("HumanoidRootPart") then return end
    local root = LP.Character.HumanoidRootPart
    local dist = (root.Position - targetPos.Position).Magnitude
    
    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
    bv.Name = "AntiFall"
    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    bv.Velocity = Vector3.zero

    if dist > 15 then 
        TS:Create(root, TweenInfo.new(dist/getgenv().TweenSpeed, Enum.EasingStyle.Linear), {CFrame = targetPos}):Play()
        return false
    else
        root.CFrame = targetPos
        return true
    end
end

local GATE_ENTER_CFRAME = CFrame.new(3864.68, 6.73, -1926.21)
local GATE_ENTER_POS = Vector3.new(61163, 11, 1819)
local GATE_EXIT_CFRAME = CFrame.new(61163, 11, 1819)
local GATE_EXIT_POS = Vector3.new(3864.68, 6.73, -1926.21)

local function CheckTeleport(targetCFrame)
    local char = LP.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local myPos = char.HumanoidRootPart.Position
    local destPos = targetCFrame.Position

    if destPos.X > 50000 and myPos.X < 50000 then
        if (myPos - GATE_ENTER_CFRAME.Position).Magnitude > 15 then TweenTo(GATE_ENTER_CFRAME)
        else GetCommF():InvokeServer("requestEntrance", GATE_ENTER_POS); task.wait(1) end
        return true
    elseif destPos.X < 50000 and myPos.X > 50000 then
        if (myPos - GATE_EXIT_CFRAME.Position).Magnitude > 15 then TweenTo(GATE_EXIT_CFRAME)
        else GetCommF():InvokeServer("requestEntrance", GATE_EXIT_POS); task.wait(1) end
        return true
    end
    return false
end

