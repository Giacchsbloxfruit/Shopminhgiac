-- [[ 3. HÀM ÉP LỆNH CẤT KHO ]]
local function StoreAction()
    pcall(function()
        local char = LP.Character
        local remote = GetCommF()
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                char.Humanoid:EquipTool(tool)
                task.wait(0.3)
                remote:InvokeServer("StoreFruit", tool.Name:gsub(" Fruit", ""), tool)
            end
        end
    end)
end

task.spawn(function() while task.wait(2) do StoreAction() end end)

