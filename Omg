local function AutoSea2()
    if PlaceId == 2753915549 and LP.Data.Level.Value >= 700 then
        local progress = Remote:InvokeServer("DressrosaQuestProgress", "Detective")
        if progress == "Detected" then
            TweenTo(CFrame.new(-466, 47, 852), getgenv().TweenSpeed)
            if (LP.Character.HumanoidRootPart.Position - Vector3.new(-466, 47, 852)).Magnitude < 10 then
                Remote:InvokeServer("TravelDressrosa")
            end
        else
            local Boss = workspace.Enemies:FindFirstChild("Ice Admiral") or workspace.Enemies:FindFirstChild("Ice Admiral [Lv. 700]")
            if Boss and Boss:FindFirstChild("Humanoid") and Boss.Humanoid.Health > 0 then
                EquipMelee()
                TweenTo(Boss.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0), getgenv().TweenSpeed)
                RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                RS.Modules.Net["RE/RegisterHit"]:FireServer(Boss.PrimaryPart, {{Boss, Boss.PrimaryPart}})
            else
                TweenTo(CFrame.new(1347, 37, -1325), getgenv().TweenSpeed)
            end
        end
        return true
    end
    return false
end

