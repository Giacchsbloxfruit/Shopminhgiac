end)

-- [[ HÀM TỰ CẦM VŨ KHÍ ]]
local function EquipWeapon()
    local tool = LP.Backpack:FindFirstChild(Config.WeaponType) or LP.Character:FindFirstChild(Config.WeaponType)
    if not tool then
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v.ToolTip == Config.WeaponType then tool = v break end
        end
    end
    if tool and not LP.Character:FindFirstChild(tool.Name) then
        LP.Character.Humanoid:EquipTool(tool)
    end
end

-- [[ VÒNG LẶP CHÍNH ]]
task.spawn(function()
    while task.wait() do
        pcall(function()
            -- 1. ƯU TIÊN SỐ 1: TÌM FRUIT TRÊN ĐẤT
            local Fruit = nil
            for _, v in pairs(workspace:GetChildren()) do
                if v:IsA("Tool") and (string.find(v.Name, "Fruit") or string.find(v.Name, "Trái")) then
                    Fruit = v break
                end
            end

            if Config.AutoFruit and Fruit then
                Config.CurrentStatus = "🍎 PHÁT HIỆN FRUIT: " .. Fruit.Name
                TweenTo(Fruit.Handle.CFrame)
                firetouchinterest(LP.Character.HumanoidRootPart, Fruit.Handle, 0)
                firetouchinterest(LP.Character.HumanoidRootPart, Fruit.Handle, 1)
                task.wait(0.5)
                CommF:InvokeServer("StoreFruit", Fruit:GetAttribute("FruitName") or Fruit.Name, Fruit)
            
            -- 2. NẾU KHÔNG CÓ FRUIT THÌ MỚI LÀM CÁC VIỆC KHÁC
            else
                -- Auto Stats
                if Config.AutoStats and LP.Data.StatsPoints.Value > 0 then
                    CommF:InvokeServer("AddPoint", "Melee", 1)
                    CommF:InvokeServer("Defense", 1)
                end

                -- Auto Farm
                if Config.AutoFarm then
                    local myLv = LP.Data.Level.Value
                    local q = nil
                    for _, v in pairs(QuestList) do
                        if myLv >= v.MinLv and myLv <= v.MaxLv then q = v break end
                    end

                    if q then
                        local QuestGui = LP.PlayerGui.Main.Quest
                        local HasQuest = QuestGui.Visible and string.find(QuestGui.Container.QuestTitle.Title.Text, q.Mon)

                        if not HasQuest then
                            Config.CurrentStatus = "📍 Đi nhận Quest: " .. q.Mon
                            TweenTo(q.NPC)
                            if (LP.Character.HumanoidRootPart.Position - q.NPC.Position).Magnitude < 10 then
                                CommF:InvokeServer("StartQuest", q.Name, q.Lv)
                            end
                        else
                            local Enemy = nil
                            for _, e in pairs(workspace.Enemies:GetChildren()) do
                                if e.Name == q.Mon and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                                    Enemy = e break
                                end
                            end

                            if Enemy then
                                Config.CurrentStatus = "⚔️ Đang dọn: " .. q.Mon
                                EquipWeapon()
                                TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0))
                                Net["RE/RegisterAttack"]:FireServer(0)
                                Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                            else
                                Config.CurrentStatus = "⏳ Đợi quái spawn..."
                                TweenTo(q.NPC * CFrame.new(0, 50, 0))
                            end
                        end
                    else
                        Config.CurrentStatus = "❌ LEVEL CỦA BẠN CHƯA CÓ TRONG DANH SÁCH!"
                    end
                end
            end
        end)
    end
end)

