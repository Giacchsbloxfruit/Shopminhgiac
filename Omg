-- [[ CONFIGURATION ]]
getgenv().Config = {
    AutoFarm = true,
    AutoStats = true,
    AutoFruit = true,
    AutoStore = true,
    AutoRandom = true,
    WeaponType = "Melee",
    TweenSpeed = 100, -- Tăng tốc độ bay tối ưu
    CurrentStatus = "Đang khởi động..."
}

-- [[ SERVICES ]]
local Players = game:GetService("Players")
local LP = Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")
local CommF = RS:WaitForChild("Remotes"):WaitForChild("CommF_")
local Net = RS:WaitForChild("Modules"):WaitForChild("Net")

-- [[ DATA ]]
local QuestList = {
    {MinLv = 1, MaxLv = 14, Name = "BanditQuest1", Lv = 1, NPC = CFrame.new(1060, 16, 1547), Mon = "Bandit"},
    {MinLv = 15, MaxLv = 29, Name = "JungleQuest", Lv = 1, NPC = CFrame.new(-1601, 36, 153), Mon = "Monkey"},
    {MinLv = 30, MaxLv = 39, Name = "BuggyQuest1", Lv = 1, NPC = CFrame.new(-1140, 4, 3827), Mon = "Pirate"}
}

-- [[ OPTIMIZED FUNCTIONS ]]

local CurrentTween = nil
local function TweenTo(TargetCFrame)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Nếu có Tween cũ đang chạy thì hủy để tránh xung đột vị trí
    if CurrentTween then CurrentTween:Cancel() end

    local dist = (TargetCFrame.Position - root.Position).Magnitude
    if dist < 5 then root.CFrame = TargetCFrame return end

    if not root:FindFirstChild("BV") then
        local bv = Instance.new("BodyVelocity", root)
        bv.Name = "BV"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
    end

    local info = TweenInfo.new(dist/getgenv().Config.TweenSpeed, Enum.EasingStyle.Linear)
    CurrentTween = TS:Create(root, info, {CFrame = TargetCFrame})
    CurrentTween:Play()
end

local function StoreFruit()
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if string.find(v.Name, "Fruit") then
            CommF:InvokeServer("StoreFruit", v:GetAttribute("FruitName") or v.Name, v)
        end
    end
end

-- Hàm tìm Fruit trong Workspace (Ưu tiên cao nhất)
local function FindFruitInWorkspace()
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Tool") and string.find(v.Name, "Fruit") then
            return v
        end
    end
    return nil
end

-- [[ MAIN EXECUTION LOOP ]]
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            -- 1. KIỂM TRA FRUIT (ƯU TIÊN SỐ 1)
            local FruitOnFloor = FindFruitInWorkspace()
            
            if Config.AutoFruit and FruitOnFloor then
                getgenv().Config.CurrentStatus = "🍎 PHÁT HIỆN FRUIT! ĐANG ĐẾN LẤY..."
                if FruitOnFloor:FindFirstChild("Handle") then
                    TweenTo(FruitOnFloor.Handle.CFrame)
                    firetouchinterest(LP.Character.HumanoidRootPart, FruitOnFloor.Handle, 0)
                    task.wait(0.2)
                    StoreFruit()
                end
                -- Khi có Fruit, bỏ qua toàn bộ phần code bên dưới (không farm, không nhận quest)
                return 
            end

            -- 2. TỰ ĐỘNG QUAY TRÁI (GACHA)
            if Config.AutoRandom then
                CommF:InvokeServer("Cousin", "Buy")
                StoreFruit()
            end

            -- 3. TỰ ĐỘNG NÂNG STATS
            if Config.AutoStats and LP.Data.StatsPoints.Value > 0 then
                CommF:InvokeServer("AddPoint", "Melee", 1)
                CommF:InvokeServer("Defense", 1)
            end

            -- 4. AUTO FARM QUÁI (CHỈ CHẠY KHI KHÔNG CÓ FRUIT TRÊN SÀN)
            if Config.AutoFarm then
                local myLv = LP.Data.Level.Value
                local q = nil
                for _, v in pairs(QuestList) do
                    if myLv >= v.MinLv and myLv <= v.MaxLv then q = v break end
                end

                if q then
                    local QuestGui = LP.PlayerGui.Main.Quest
                    local IsDoingCorrectQuest = QuestGui.Visible and string.find(QuestGui.Container.QuestTitle.Title.Text, q.Mon)

                    if not IsDoingCorrectQuest then
                        getgenv().Config.CurrentStatus = "📍 Đang đi nhận nhiệm vụ..."
                        TweenTo(q.NPC)
                        if (LP.Character.HumanoidRootPart.Position - q.NPC.Position).Magnitude < 10 then
                            CommF:InvokeServer("StartQuest", q.Name, q.Lv)
                        end
                    else
                        -- Tìm mục tiêu đánh
                        local Enemy = nil
                        for _, e in pairs(workspace.Enemies:GetChildren()) do
                            if e.Name == q.Mon and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then
                                Enemy = e break
                            end
                        end

                        if Enemy then
                            getgenv().Config.CurrentStatus = "⚔️ Đang farm: " .. q.Mon
                            -- Tự cầm vũ khí
                            if not LP.Character:FindFirstChildWhichIsA("Tool") then
                                for _, t in pairs(LP.Backpack:GetChildren()) do
                                    if t.ToolTip == Config.WeaponType or t.Name == Config.WeaponType then
                                        LP.Character.Humanoid:EquipTool(t)
                                    end
                                end
                            end
                            -- Bay đến quái và tấn công
                            TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0))
                            Net["RE/RegisterAttack"]:FireServer(0)
                            Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                        else
                            getgenv().Config.CurrentStatus = "⏳ Đợi quái spawn..."
                            TweenTo(q.NPC * CFrame.new(0, 50, 0))
                        end
                    end
                end
            end
        end)
    end
end)

