-- [[ 3. AUTO SERVER HOP (30 PHÚT) ]]
task.spawn(function()
    task.wait(getgenv().ServerHopTime)
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local Api = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
    local function Hop()
        local Servers = HttpService:JSONDecode(game:HttpGet(Api))
        for _, s in pairs(Servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LP)
                break
            end
        end
    end
    Hop()
