local function SendDiscordNotification(fruitName, status)
    if LastNotifiedFruit == fruitName then return end 
    local url = getgenv().WebhookURL
    local color = (status == "Thành công") and 3066993 or 15158332
    local data = {
        ["content"] = "🚀 **CẬP NHẬT TRẠNG THÁI KHO ĐỒ**",
        ["embeds"] = {{
            ["title"] = "📦 HỆ THỐNG TỰ ĐỘNG CẤT TRÁI",
            ["description"] = "👤 Tài khoản: **" .. LP.Name .. "**\n🎁 Trái ác quỷ: **" .. fruitName .. "**\n📊 Trạng thái: **" .. status .. "**",
            ["color"] = color,
            ["footer"] = { ["text"] = "Giacdz kaitun • " .. os.date("%X") }
        }}
    }
    local request = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if request then
        request({Url = url, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = game:GetService("HttpService"):JSONEncode(data)})
        LastNotifiedFruit = fruitName 
    end
end

-- [[ 3. HÀM CẤT KHO ]]
local function StoreAction()
    pcall(function()
        local char = LP.Character
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                char.Humanoid:EquipTool(tool)
                task.wait(0.3)
            end
        end
        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local result = GetCommF():InvokeServer("StoreFruit", toolOnHand.Name:gsub(" Fruit", ""), toolOnHand)
            local statusMsg = (result == 2 or result == "Full") and "Thất bại - Túi đã đầy (Max Storage)" or "Thành công"
            SendDiscordNotification(toolOnHand.Name, statusMsg)
            task.wait(1)
        end
    end)
end
task.spawn(function() while task.wait(1) do StoreAction() end end)

