-- Hàm tìm Remote CommF_
local function GetCommF()
    local found = RS:FindFirstChild("CommF_", true)
    if not found then
        for _, v in pairs(RS:GetDescendants()) do
            if v.Name == "CommF_" then return v end
        end
    end
    return found
end

-- [[ 2. HÀM GỬI THÔNG BÁO DISCORD ]]
local function SendDiscordNotification(fruitName)
    local url = getgenv().WebhookURL
    local data = {
        ["content"] = "🚀 **THÔNG BÁO HỆ THỐNG KHO ĐỒ**",
        ["embeds"] = {{
            ["title"] = "📦 ĐÃ TỰ ĐỘNG CẤT TRÁI VÀO KHO!",
            ["description"] = "👤 Tài khoản: **" .. LP.Name .. "**\n🎁 Trái ác quỷ: **" .. fruitName .. "**\n✅ Trạng thái: **Đã ép lệnh cất kho thành công!**",
            ["color"] = 3447003,
            ["footer"] = { ["text"] = "Gemini Blox Fruit Script • " .. os.date("%X") }
        }}
    }
    local request = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if request then
        request({
            Url = url,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = game:GetService("HttpService"):JSONEncode(data)
        })
    end
end

-- [[ 3. HÀM ÉP LỆNH CẤT KHO (NHỒI LỆNH BYPASS) ]]
local function StoreAction()
    pcall(function()
        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local remote = GetCommF()
        
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                task.wait(0.2)
            end
        end

        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            task.defer(function()
                if remote then
                    remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", fruitName.."-"..fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", toolOnHand.Name, toolOnHand)
                end
            end)
            SendDiscordNotification(toolOnHand.Name)
            task.wait(1)
        end
    end)
end

-- [[ 4. FRUIT SNIPER (NHẶT TRÁI TRÊN ĐẤT) ]]
local function CheckFruitOnGround()
    for _, v in pairs(workspace:GetChildren()) do
        if v:IsA("Tool") or (v:IsA("Model") and string.find(v.Name, "Fruit")) then
            local handle = v:FindFirstChild("Handle") or v.PrimaryPart
            if handle then
                TweenTo(handle.CFrame, getgenv().FruitSpeed)
                if (LP.Character.HumanoidRootPart.Position - handle.Position).Magnitude < 10 then
                    if v:IsA("Model") then
                        firetouchinterest(LP.Character.HumanoidRootPart, handle, 0)
                        task.wait(0.1)
                        firetouchinterest(LP.Character.HumanoidRootPart, handle, 1)
                    end
                end
                return true
            end
        end
    end
    return false
end

