local function CheckQuest()
    local myLv = LP.Data.Level.Value
    for _, v in pairs(QuestList) do
        if myLv >= v.Min and myLv <= v.Max then
            NameQuest, LevelQuest, NameMon, CFrameQuest, CFrameMon = v.Name, v.Lv, v.Mon, v.NPC, v.MonPos
            return
        end
    end
end

local function IsQuestActive()
    local gui = LP.PlayerGui:FindFirstChild("Main")
    local qGui = gui and gui:FindFirstChild("Quest")
    if qGui and qGui.Visible then
        local text = qGui.Container.QuestTitle.Title.Text
        return string.find(text, NameMon) ~= nil
    end
    return false
end

local function EquipMelee()
    pcall(function()
        if not LP.Character:FindFirstChild("HasBuso") then GetCommF():InvokeServer("Buso") end
        local tool = LP.Character:FindFirstChildOfClass("Tool")
        if not tool or tool.ToolTip ~= "Melee" then
            for _, v in pairs(LP.Backpack:GetChildren()) do
                if v.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(v); break end
            end
        end
    end)
end

