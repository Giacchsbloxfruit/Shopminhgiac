local LP = game.Players.LocalPlayer
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")

_G.StopFarmForMelee = false 
getgenv().ReqMasToBuy = 450 -- Đổi thành 0 nếu bạn muốn test bay thẳng đến NPC
getgenv().TweenSpeed = 200

-- Hàm lấy Remote Event giao tiếp với Server
local function GetCommF()
    local found = RS:FindFirstChild("CommF_", true)
    if not found then
        for _, v in pairs(RS:GetDescendants()) do
            if v.Name == "CommF_" then return v end
        end
    end
    return found
end

-- Hàm kiểm tra tên Võ và Mastery hiện tại
local function GetMeleeData()
    local name, mas = "", 0
    -- Tìm trong Balo
    if LP:FindFirstChild("Backpack") then
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v:IsA("Tool") and v.ToolTip == "Melee" then
                name = v.Name; if v:FindFirstChild("Level") then mas = v.Level.Value end
            end
        end
    end
    -- Tìm trên tay nhân vật
    if LP.Character then
        for _, v in pairs(LP.Character:GetChildren()) do
            if v:IsA("Tool") and v.ToolTip == "Melee" then
                name = v.Name; if v:FindFirstChild("Level") then mas = v.Level.Value end
            end
        end
    end
    return name, mas
end

-- Vòng lặp chạy ngầm xử lý Auto Mua
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            local myBeli = LP.Data.Beli.Value
            local curName, curMas = GetMeleeData()
            local targetPos, buyCmd = nil, ""
            local isFishman = false

            -- 1. Mua Black Leg (Chân Đen)
            if (curName == "Combat" or curName == "") and myBeli >= 150000 then
                targetPos = CFrame.new(1134, 5, 4373)
                buyCmd = "BuyBlackLeg"
                
            -- 2. Mua Electro (Điện)
            elseif curName == "Black Leg" and curMas >= getgenv().ReqMasToBuy and myBeli >= 500000 then
                targetPos = CFrame.new(-5381, 15, -2184)
                buyCmd = "BuyElectro"
                
            -- 3. Mua Water Kung Fu (Người Cá)
            elseif curName == "Electric" and curMas >= getgenv().ReqMasToBuy and myBeli >= 750000 then
                targetPos = CFrame.new(61585, 19, 987)
                buyCmd = "BuyFishmanKarate"
                isFishman = true
            end

            -- Nếu đủ điều kiện mua võ mới
            if targetPos then
                _G.StopFarmForMelee = true -- Phát tín hiệu dừng các hàm farm quái khác
                
                -- Xử lý chui qua cổng nước Đảo Người Cá
                if isFishman and LP.Character.HumanoidRootPart.Position.Y > -500 then
                    GetCommF():InvokeServer("requestEntrance", Vector3.new(61163, 11, 1819))
                    task.wait(1.5)
                end
                
                local root = LP.Character.HumanoidRootPart
                local dist = (root.Position - targetPos.Position).Magnitude
                
                if dist > 15 then
                    -- Bay đến vị trí NPC
                    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
                    bv.Name = "AntiFall"; bv.MaxForce = Vector3.new(1e9, 1e9, 1e9); bv.Velocity = Vector3.zero
                    TS:Create(root, TweenInfo.new(dist/getgenv().TweenSpeed, Enum.EasingStyle.Linear), {CFrame = targetPos}):Play()
                else
                    -- Đã tới nơi -> Mua võ
                    GetCommF():InvokeServer(buyCmd)
                end
            else
                _G.StopFarmForMelee = false -- Không mua võ -> Tiếp tục farm bình thường
            end
        end)
    end
end)
