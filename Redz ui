-- Hiệu ứng Rainbow cho viền nút
task.spawn(function()
    local Colors = {Color3.new(1,0,0), Color3.new(1,1,0), Color3.new(0,1,0), Color3.new(0,1,1), Color3.new(0,0,1), Color3.new(1,0,1)}
