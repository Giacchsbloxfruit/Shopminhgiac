MainBtn.Position = UDim2.new(0.15, 0, 0.15, 0)
MainBtn.Image = "rbxassetid://123060196429580"
MainBtn.BackgroundTransparency = 1

local UICorner = Instance.new("UICorner", MainBtn)
UICorner.CornerRadius = UDim.new(0.25, 0)

local Stroke = Instance.new("UIStroke", MainBtn)
Stroke.Thickness = 2
Stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

-- Hiệu ứng cầu vồng cho viền nút
task.spawn(function()
    local Colors = {
        Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 127, 0), Color3.fromRGB(255, 255, 0),
        Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 255, 255), Color3.fromRGB(0, 0, 255),
        Color3.fromRGB(139, 0, 255)
    }
    local i = 1
    while true do
        Stroke.Color = Colors[i]
        i = i % #Colors + 1
        task.wait(0.3)
    end
end)

-- Logic Kéo thả (Draggable) cho nút bấm
local Dragging, DragInput, DragStart, StartPos
MainBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        Dragging = true
        DragStart = input.Position
        StartPos = MainBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then Dragging = false end
        end)
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local Delta = input.Position - DragStart
        MainBtn.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + Delta.X, StartPos.Y.Scale, StartPos.Y.Offset + Delta.Y)
    end
end)

-- Click để thu gọn/mở Menu
MainBtn.MouseButton1Click:Connect(function()
    v1:Minimize(not v1.IsMinimized)
end)

