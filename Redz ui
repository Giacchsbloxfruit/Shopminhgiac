-- Logic Kéo thả (Draggable)
local v474 = false
local v476, v477, v475
l_ImageButton_0.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        v474 = true
        v476 = input.Position
        v477 = l_ImageButton_0.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then v474 = false end
        end)
    end
end)
l_ImageButton_0.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        v475 = input
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if v474 and input == v475 then
        local delta = input.Position - v476
        l_ImageButton_0.Position = UDim2.new(v477.X.Scale, v477.X.Offset + delta.X, v477.Y.Scale, v477.Y.Offset + delta.Y)
    end
end)

