-- [[ 4. NHẶT TRÁI & MUA CHIP (NGOÀI RAID) ]]
-- ==========================================
task.spawn(function()
    while task.wait(0.5) do
        if not IsInRaid() then
            if _G.Grabfruit then
                for _, v in pairs(workspace:GetChildren()) do
                    if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
                        LP.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                        LastGrabTime = tick()
                    end
                end
            end
            
            local chip = LP.Backpack:FindFirstChild("Special Microchip") or LP.Character:FindFirstChild("Special Microchip")
            local canBuy = (tick() - ScriptStartedTime > 10) and (tick() - LastGrabTime > 5)
            
            if _G.AutoBuyChip and not CheckFull() and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
                Notify("Đã mua Chip Raid: " .. _G.SelectChip)
            end
            
            if _G.StartRaid and chip then
                local RaidPos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(RaidPos)
                if (LP.Character.HumanoidRootPart.Position - RaidPos.Position).Magnitude < 15 then
                    local btn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if btn then fireclickdetector(btn.ClickDetector) end
                end
            end
        else
            BoughtChip = false
        end
    end
end)

