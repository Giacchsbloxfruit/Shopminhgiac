-- [[ 4 & 5. MUA CHIP & START RAID ]]
task.spawn(function()
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
        if not inRaid and (tick() - LastGrabTime) > 5 then
            if _G.AutoBuyChip and not HasItem("Special Microchip") then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
            end
            if _G.StartRaid and HasItem("Special Microchip") then
                local Sea2_Pos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(Sea2_Pos)
                if (LP.Character.HumanoidRootPart.Position - Sea2_Pos.Position).Magnitude < 20 then
                    Remote:InvokeServer("SetSpawnPoint")
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then fireclickdetector(RaidBtn.ClickDetector) end
                end
            end
        end
    end
end)

-- [[ 6. CHỈ ĐÁNH KHI TRONG RAID ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        local inRaid = LP.PlayerGui.Main.Timer.Visible
        
        if _G.Dungeon and (inRaid or island) then
            EquipWeapon()
            local target = nil
            local dist = math.huge
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d; target = v end
                end
            end
            if target then
                topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
            elseif island then
                topos_tween(island.CFrame * CFrame.new(0, 70, 0))
            end
        else
            -- Nếu hết Raid, xóa BodyVelocity để không bị bay lung tung
            StopTween()
        end
    end
end)

-- [[ 7. HOP SERVER ]]
function HopServer()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    pcall(function()
        local result = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
        for _, s in pairs(result.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                break
            end
        end
    end)
end

task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Special Microchip")
            local hasFruit = HasItem("Fruit")

            -- Chỉ đếm ngược khi: Hết Raid VÀ Hết Chip VÀ Hết Trái
            if not inRaid and not hasChip and not hasFruit then
                waitTime = waitTime - 1
                if waitTime == 10 then Notify("Đang check túi... 10s nữa Hop")
                elseif waitTime == 5 then Notify("Túi sạch! Đổi Server sau 5s")
                elseif waitTime <= 0 then
                    Notify("Hopping...")
                    HopServer()
                    waitTime = 15
                end
            else
                waitTime = 15 -- Reset nếu còn việc để làm
            end
        end
    end
end)

