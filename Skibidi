-- Tự động cầm vũ khí
local function EquipWeapon(weaponType)
    pcall(function()
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v:IsA("Tool") and v.ToolTip == weaponType then
                LP.Character.Humanoid:EquipTool(v)
            end
        end
    end)
end

-- Tìm đảo hiện tại (Logic Bản 3)
local function GetCurrentIsland()
    local locations = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if not locations then return nil end
    for i = 5, 1, -1 do
        local island = locations:FindFirstChild("Island " .. i)
        if island then return island end
    end
    return nil
end

local function IsInRaid()
    return (LP.PlayerGui.Main:FindFirstChild("Timer") and LP.PlayerGui.Main.Timer.Visible) or GetCurrentIsland()
end

local function CheckFull()
    local has = false
    if not LP.Character then return false end
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit") or v.Name == "Special Microchip") then has = true break end
    end
    if not has then
        for _, v in pairs(LP.Character:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit") or v.Name == "Special Microchip") then has = true break end
        end
    end
    return has
end

local function topos_tween(Pos)
    pcall(function()
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        local Distance = (Pos.Position - Root.Position).Magnitude
        if Distance < 5 then 
            if Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
            return 
        end 
        if not Root:FindFirstChild("DungeonBV") then
            local bv = Instance.new("BodyVelocity", Root)
            bv.Name = "DungeonBV"; bv.MaxForce = Vector3.new(9e9, 9e9, 9e9); bv.Velocity = Vector3.new(0,0,0)
        end
        TS:Create(Root, TweenInfo.new(Distance/_G.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

