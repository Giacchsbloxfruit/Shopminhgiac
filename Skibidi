-- [[ 5. ĐÁNH QUÁI TRONG RAID ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            -- Tự cầm Melee
            if not LP.Character:FindFirstChildOfClass("Tool") then
                for _, t in pairs(LP.Backpack:GetChildren()) do
                    if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) end
                end
            end
            -- Đánh quái
            local target = nil
            local dist = math.huge
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d; target = v end
                end
            end
            if target then
                topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
            else
                topos_tween(island.CFrame * CFrame.new(0, 70, 0))
            end
        else
            if LP.Character.HumanoidRootPart:FindFirstChild("DungeonBV") then
                LP.Character.HumanoidRootPart.DungeonBV:Destroy()
            end
        end
    end
end)

-- [[ 6. HÀM HOP SERVER KHÔNG TRÙNG (FIX LỖI CHỈ HOP 1 SV) ]]
function ServerHop()
    local Http = game:GetService("HttpService")
    local TPS = game:GetService("TeleportService")
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local function GetServers(cursor)
        local raw = game:HttpGet(Api .. (cursor and "&cursor=" .. cursor or ""))
        return Http:JSONDecode(raw)
    end

    local serverPage = GetServers()
    while serverPage do
        for _, server in pairs(serverPage.data) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                TPS:TeleportToPlaceInstance(game.PlaceId, server.id, LP)
                return
            end
        end
        if serverPage.nextPageCursor then
            serverPage = GetServers(serverPage.nextPageCursor)
        else
            break
        end
    end
    Notify("Không tìm thấy server mới, đang thử lại...")
end

-- [[ 7. LOGIC CHECK TÚI & HOP SERVER LIÊN TỤC ]]
task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Special Microchip")
            local hasFruit = HasItem("Fruit")

            -- Nếu không Raid, không Chip, không Trái thì mới đếm ngược
            if not inRaid and not hasChip and not hasFruit then
                waitTime = waitTime - 1
                if waitTime % 5 == 0 or waitTime <= 5 then
                    Notify("Túi sạch! Đang check... " .. waitTime .. "s nữa đổi Server")
                end
                
                if waitTime <= 0 then
                    Notify("Đang nhảy Server mới...")
                    ServerHop()
                    waitTime = 15
                end
            else
                -- Nếu còn việc (đang Raid hoặc có đồ), reset đồng hồ
                waitTime = 15
            end
        end
    end
end)

