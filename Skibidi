task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if IsInRaid() then BoughtChip = false return end
            local chipTool = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            local canBuy = (tick() - ScriptStartedTime > 10) and (tick() - LastGrabTime > 5)
            if _G.AutoBuyChip and not CheckFull() and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
            end
            if _G.StartRaid and chipTool then
                local RaidControlPos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(RaidControlPos)
                if (LP.Character.HumanoidRootPart.Position - RaidControlPos.Position).Magnitude < 15 then
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then fireclickdetector(RaidBtn.ClickDetector) end
                end
            end
        end)
    end
end)

