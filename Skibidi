-- [[ 3. AUTO MUA CHIP & VÀO RAID (ĐÃ LƯỢC BỎ CẦM CHIP) ]]
-- ==========================================
task.spawn(function()
    while task.wait(1) do
        pcall(function()
            if IsInRaid() then 
                BoughtChip = false 
                return 
            end

            local chipTool = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            
            -- ĐIỀU KIỆN MUA CHIP: Chưa có chip, túi không có trái ác quỷ, và đã qua 10s ổn định, 5s sau khi nhặt trái
            local canBuy = (tick() - ScriptStartedTime > 10) and (tick() - LastGrabTime > 5)

            if _G.AutoBuyChip and not CheckFull() and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
            end

            -- LOGIC BẤM NÚT VÀO RAID
            if _G.StartRaid and chipTool then
                local RaidControlPos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(RaidControlPos)
                
                if (LP.Character.HumanoidRootPart.Position - RaidControlPos.Position).Magnitude < 15 then
                    -- Bấm nút trực tiếp luôn, không cần lấy Chip ra tay
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn and RaidBtn:FindFirstChild("ClickDetector") then 
                        fireclickdetector(RaidBtn.ClickDetector) 
                    end
                end
            end
        end)
    end
end)

-- ==========================================
-- [[ 4. AUTO HOP SERVER (TÌM SERVER VẮNG NGƯỜI) ]]
-- ==========================================
task.spawn(function()
    local counter = 0
    task.wait(10) -- Chờ 10s đầu tiên để game load xong
    
    while task.wait(1) do
        if _G.AutoHop and not IsInRaid() then
            if CheckFull() then
                counter = 0 -- Reset đếm nếu trong túi có Trái/Chip
            else
                counter = counter + 1
                if counter >= 15 then
                    Notify("Túi trống 15s. Đang tìm Server Vắng...")
                    pcall(function()
                        -- sortOrder=Asc giúp đưa các server ít người lên đầu
                        local Api = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
                        local Result = HttpService:JSONDecode(game:HttpGet(Api))
                        
                        for _, s in pairs(Result.data) do
                            -- Chỉ vào server có người chơi nhưng dưới 5 người
                            if s.id ~= game.JobId and s.playing > 0 and s.playing < 5 then
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                break
                            end
                        end
                    end)
                    counter = 0
                end
            end
        else
            counter = 0
        end
    end
end)

