-- [[ 6. COMPLETE RAID + AUTO EQUIP ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end end
    return nil
end

task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            EquipMelee() -- Luôn cầm melee khi trong Raid
            local target, dist = nil, math.huge
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d; target = v end
                end
            end
            if target then
                topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
            else
                topos_tween(island.CFrame * CFrame.new(0, 60, 0))
            end
        end
    end
end)

-- [[ 7. HOP SERVER + THÔNG BÁO ]]
function ForceHop()
    local HttpService = game:GetService("HttpService")
    local result = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
    for _, s in pairs(result.data) do
        if s.id ~= game.JobId and s.playing < s.maxPlayers then
            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, LP)
            break
        end
    end
end

task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Special Microchip")
            local hasFruit = HasItem("Fruit")

            if not inRaid and not hasChip and not hasFruit then
                waitTime = waitTime - 1
                if waitTime == 10 then Notify("Hệ thống: Đang kiểm tra Server... (10s)")
                elseif waitTime == 5 then Notify("Hệ thống: Sắp đổi Server... (5s)")
                elseif waitTime <= 0 then
                    Notify("Hệ thống: Đang nhảy Server!")
                    ForceHop()
                    waitTime = 15
                end
            else
                -- Nếu có Trái/Chip hoặc đang Raid, reset thời gian và báo cho người dùng
                if waitTime < 15 then
                    Notify("Hệ thống: Đã dừng Hop để ưu tiên Raid/Trái ác quỷ")
                    waitTime = 15
                end
            end
        end
    end
end)

