-- [[ 5. AUTO HOP VẮNG NGƯỜI ]]
-- ==========================================
task.spawn(function()
    local counter = 0
    task.wait(10)
    while task.wait(1) do
        if _G.AutoHop and not IsInRaid() then
            if CheckFull() then counter = 0 else
                counter = counter + 1
                if counter >= 15 then
                    pcall(function()
                        local Api = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
                        local Result = HttpService:JSONDecode(game:HttpGet(Api))
                        for _, s in pairs(Result.data) do
                            if s.id ~= game.JobId and s.playing > 0 and s.playing < 5 then
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                break
                            end
                        end
                    end)
                    counter = 0
                end
            end
        else counter = 0 end
    end
end)

