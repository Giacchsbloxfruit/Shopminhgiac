-- [[ 5. AUTO HOP SERVER (CÓ THÔNG BÁO) ]]
-- ==========================================
task.spawn(function()
    local counter = 0
    task.wait(10) -- Đợi 10s đầu
    
    while task.wait(1) do
        if _G.AutoHop and not IsInRaid() then
            if CheckFull() then 
                counter = 0 -- Reset nếu có đồ trong túi
            else
                counter = counter + 1
                
                -- Thông báo để bạn biết script đang hoạt động
                if counter == 1 then
                    print("Giacdz Hub: Đang check túi trống...")
                elseif counter == 5 then
                    Notify("Túi trống 5s... Tiếp tục check")
                elseif counter == 10 then
                    Notify("Túi trống 10s... Sắp Hop Server")
                elseif counter >= 15 then
                    Notify("Đang nhảy Server vắng người!")
                    pcall(function()
                        local Api = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
                        local Result = HttpService:JSONDecode(game:HttpGet(Api))
                        for _, s in pairs(Result.data) do
                            if s.id ~= game.JobId and s.playing > 0 and s.playing < 5 then
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                break
                            end
                        end
                    end)
                    counter = 0
                end
            end
        else 
            counter = 0 
        end
    end
end)

