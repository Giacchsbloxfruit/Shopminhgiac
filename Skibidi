-- [[ THÔNG BÁO ]]
local function Notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Giacdz Hub",
            Text = text,
            Duration = 3
        })
    end)
end

-- [[ KIỂM TRA TÚI/TAY ]]
local function HasItem(itemName)
    for _, v in pairs(LP.Backpack:GetChildren()) do
        if v:IsA("Tool") and (v.ToolTip == itemName or string.find(v.Name, itemName)) then return true end
    end
    if LP.Character then
        for _, v in pairs(LP.Character:GetChildren()) do
            if v:IsA("Tool") and (v.ToolTip == itemName or string.find(v.Name, itemName)) then return true end
        end
    end
    return false
end

-- [[ TỰ CẦM VŨ KHÍ ]]
local function EquipWeapon()
    if not LP.Character:FindFirstChildOfClass("Tool") then
        for _, t in pairs(LP.Backpack:GetChildren()) do
            if t.ToolTip == _G.SelectWeapon then
                LP.Character.Humanoid:EquipTool(t)
                break
            end
        end
    end
end

-- [[ DI CHUYỂN TWEEN ]]
local function topos_tween(Pos)
    pcall(function()
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        local Distance = (Pos.Position - Root.Position).Magnitude
        
        -- Nếu khoảng cách quá gần thì dừng Tween
        if Distance < 5 then 
            if Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
            return 
        end 

        if not Root:FindFirstChild("DungeonBV") then
            local bv = Instance.new("BodyVelocity", Root)
            bv.Name = "DungeonBV"; bv.Velocity = Vector3.new(0,0,0); bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        end
        TS:Create(Root, TweenInfo.new(Distance/200, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

-- [[ RESET TWEEN KHI RAID XONG ]]
local function StopTween()
    local Root = LP.Character:FindFirstChild("HumanoidRootPart")
    if Root and Root:FindFirstChild("DungeonBV") then
        Root.DungeonBV:Destroy()
    end
end

-- [[ CHECK ĐẢO RAID ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then 
        for i=5,1,-1 do 
            if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end 
        end 
    end
    return nil
end

