-- [[ HÀM HỖ TRỢ ]]
local function Notify(text)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Gemini Hub",
        Text = text,
        Duration = 3
    })
end

local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then 
        for i=5,1,-1 do 
            if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end 
        end 
    end
    return nil
end

-- [[ 1. CHỌN PHE CƯỠNG CHẾ ]]
task.spawn(function()
    while task.wait(1) do
        if LP.Team == nil or LP.Team.Name ~= getgenv().Team then
            pcall(function() Remote:InvokeServer("SetTeam", getgenv().Team) end)
        else break end
    end
end)

-- [[ 2. NHẶT TRÁI ]]
task.spawn(function()
    while task.wait(0.1) do
        if _G.Grabfruit then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            if not inRaid then -- Chỉ nhặt trái khi ở ngoài
                pcall(function()
                    for _, v in pairs(workspace:GetChildren()) do
                        if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then 
                            LP.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                            LastGrabTime = tick() 
                        end
                    end
                end)
            end
        end
