            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            
