-- [[ CHECK ĐẢO RAID ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then 
        for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end 
    end
    return nil
end

-- [[ LOGIC MUA CHIP & RAID ]]
task.spawn(function()
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
        local hasChip = CheckBackpack() -- Kiểm tra xem có chip hoặc trái không

        if not inRaid then
            local canBuy = (tick() - StartCheckTime > 5) and (tick() - LastGrabTime > 5)
            if not hasChip and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
            end

            if (LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))) and _G.StartRaid then
                local Sea2_Pos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(Sea2_Pos)
                if (LP.Character.HumanoidRootPart.Position - Sea2_Pos.Position).Magnitude < 20 then
                    Remote:InvokeServer("SetSpawnPoint")
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then fireclickdetector(RaidBtn.ClickDetector) end
                end
            end
        else
            BoughtChip = false 
            RaidEndTime = tick()
        end
    end
end)

-- [[ CẤT KHO & NHẶT TRÁI ]]
local function StoreAction()
    local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
    if inRaid then return end 
    for _, tool in pairs(LP.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
            LP.Character.Humanoid:EquipTool(tool)
        end
    end
    local toolOnHand = LP.Character:FindFirstChildOfClass("Tool")
    if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
        Remote:InvokeServer("StoreFruit", toolOnHand.Name:gsub(" Fruit", ""), toolOnHand)
    end
end

task.spawn(function()
    while task.wait(0.5) do StoreAction() end
end)

task.spawn(function()
