-- [[ 6. COMPLETE RAID (ÉP ĐÁNH QUÁI NẾU Ở TRONG RAID) ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if (v.HumanoidRootPart.Position - island.Position).Magnitude < 800 then
                            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist = d; target = v end
                        end
                    end
                end
                if target then
                    -- ÉP TRANG BỊ VŨ KHÍ CẬN CHIẾN
                    if not LP.Character:FindFirstChildOfClass("Tool") or LP.Character:FindFirstChildOfClass("Tool").ToolTip ~= "Melee" then
                        for _, t in pairs(LP.Backpack:GetChildren()) do 
                            if t.ToolTip == "Melee" then 
                                LP.Character.Humanoid:EquipTool(t) 
                                break
                            end 
                        end
                    end
                    topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                else
                    topos_tween(island.CFrame * CFrame.new(0, 60, 0))
                end
            end)
        else
            -- Giải phóng nhân vật ngay khi Raid kết thúc
            local Root = LP.Character:FindFirstChild("HumanoidRootPart")
            if Root and Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
        end
    end
end)

-- [[ 7. HOP SERVER CHUẨN (5S CHECK + 10S HOP) ]]
function HopServer()
    pcall(function()
        local PlaceId = game.PlaceId
        local JobId = game.JobId
        local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
        local success, result = pcall(function()
            return game.HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            for _, v in ipairs(result.data) do
                if v.playing < (v.maxPlayers - 1) and v.id ~= JobId then
                    game:GetService("TeleportService"):TeleportToPlaceInstance(PlaceId, v.id, LP)
                    task.wait(1)
                    break
                end
            end
        end
    end)
end

task.spawn(function()
    local waitTime = 15 -- Tổng thời gian là 15 giây (5s check + 10s đếm ngược)
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Microchip")
            local hasFruit = HasItem("Fruit")

            -- Chỉ chạy đếm ngược Hop nếu: Không ở trong Raid, Không có Chip, Không có Trái
            if not inRaid and not hasChip and not hasFruit then
                waitTime = waitTime - 1
                
                if waitTime > 10 then
                    -- Từ 15 về 11: Mất 5 giây để Check túi
                    Notify("Checking Backpack... " .. (waitTime - 10) .. "s")
                elseif waitTime > 0 then
                    -- Từ 10 về 1: Đếm ngược Hop
                    Notify("Clear! Server Hop in: " .. waitTime .. "s")
                else
                    -- Bằng 0: Thực thi Hop
                    Notify("Hopping to New Server...")
                    HopServer()
                    waitTime = 15 -- Reset lại 15s đề phòng lỗi mạng chưa bay kịp
                end
            else
                -- Nếu trong lúc đang đếm mà lòi ra Trái, Chip hoặc đang ở đảo Raid
                if waitTime < 15 and waitTime > 0 then
                    Notify("Hop Cancelled! Found items or in Raid.")
                end
                waitTime = 15 -- Trả lại thời gian ban đầu để tạo vòng lặp cho trận sau
            end
        end
    end
end)

