-- [[ CHECK ĐẢO RAID ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then 
        for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end 
    end
    return nil
end

-- [[ 2. HÀM ÉP LỆNH CẤT KHO (ĐÃ TRẢ LẠI NGUYÊN BẢN) ]]
local function StoreAction()
    pcall(function()
        local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
        if inRaid then return end -- Dừng khi raid

        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local remote = GetCommF()
        
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                task.wait(0.2)
            end
        end

        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            task.defer(function()
                if remote then
                    remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", fruitName.."-"..fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", toolOnHand.Name, toolOnHand)
                end
            end)
            task.wait(1) 
        end
    end)
end

task.spawn(function()
    while task.wait(0.5) do
        StoreAction()
    end
end)

