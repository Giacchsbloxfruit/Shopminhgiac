-- [[ CHECK ĐẢO RAID ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then 
        for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end 
    end
    return nil
end

-- [[ LOGIC MUA CHIP & RAID (DELAY 5S CHIP ĐẦU & SAU RAID) ]]
task.spawn(function()
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
        local hasChip = HasItem("Special Microchip")

        if not inRaid then
            if RaidEndTime == 0 then RaidEndTime = tick() end
            
            -- Chờ 5s từ khi: Vào game / Nhặt trái / Xong Raid
            local canBuy = (tick() - StartCheckTime > 5) and (tick() - LastGrabTime > 5) and (tick() - RaidEndTime > 5)

            if not hasChip and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
                Notify("Đã mua Chip " .. _G.SelectChip)
            end

            if hasChip and _G.StartRaid then
                local Sea2_Pos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(Sea2_Pos)
                if (LP.Character.HumanoidRootPart.Position - Sea2_Pos.Position).Magnitude < 20 then
                    Remote:InvokeServer("SetSpawnPoint")
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then fireclickdetector(RaidBtn.ClickDetector) end
                end
            end
        else
            BoughtChip = false 
            RaidEndTime = tick()
        end
    end
end)

-- [[ NHẶT TRÁI & CẤT KHO (DỪNG KHI TRONG RAID) ]]
task.spawn(function()
    while task.wait(0.5) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
        if not inRaid then
            if _G.Grabfruit then
                for _, v in pairs(workspace:GetChildren()) do
                    if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then 
                        LP.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                        LastGrabTime = tick() 
                    end
                end
            end
            for _, tool in pairs(LP.Backpack:GetChildren()) do
                if tool:IsA("Tool") and tool.ToolTip == "Fruit" then
                    LP.Character.Humanoid:EquipTool(tool)
                    task.wait(0.2)
                    Remote:InvokeServer("StoreFruit", tool.Name:gsub(" Fruit", ""), tool)
                end
            end
        end
    end
end)

-- [[ ĐÁNH QUÁI TRONG RAID ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            if not LP.Character:FindFirstChildOfClass("Tool") then
                for _, t in pairs(LP.Backpack:GetChildren()) do
                    if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) end
                end
            end
            local target = nil
            local dist = math.huge
            for _, v in pairs(workspace.Enemies:GetChildren()) do
                if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                    local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d; target = v end
                end
            end
            if target then
                topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
            else
                topos_tween(island.CFrame * CFrame.new(0, 60, 0))
            end
        end
    end
end)

-- [[ LOGIC CHECK & HOP SERVER ]]
task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Special Microchip")
            local hasFruit = HasItem("Fruit")

            if not inRaid then
                if hasChip or hasFruit then
                    waitTime = 15
                else
                    waitTime = waitTime - 1
                    if waitTime == 10 then Notify("Túi trống: Đang check... (10s)")
                    elseif waitTime == 5 then Notify("Túi trống: Đổi server sau 5s")
                    elseif waitTime <= 0 then
                        local servers = game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
                        for _, s in pairs(servers) do
                            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                                game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                break
                            end
                        end
                        waitTime = 15
                    end
                end
            else
                waitTime = 15
            end
        end
    end
end)

