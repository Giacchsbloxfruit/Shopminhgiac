-- [[ KIỂM TRA TÚI CÓ TRÁI ]]
local function HasFruit()
    local char = LP.Character
    if not char then return false end
    local items = LP.Backpack:GetChildren()
    for _, v in pairs(char:GetChildren()) do table.insert(items, v) end
    for _, v in pairs(items) do
        if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit")) then 
            return true 
        end
    end
    return false
end

-- [[ KIỂM TRA CÓ CHIP CHƯA ]]
local function HasChip()
    local char = LP.Character
    if not char then return false end
    if LP.Backpack:FindFirstChild("Special Microchip") or char:FindFirstChild("Special Microchip") then
        return true
    end
    return false
end

-- [[ TWEEN ]]
local function topos_tween(Pos)
    pcall(function()
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        local Distance = (Pos.Position - Root.Position).Magnitude
        if Distance < 5 then 
            if Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
            return 
        end 
        if not Root:FindFirstChild("DungeonBV") then
            local bv = Instance.new("BodyVelocity", Root)
            bv.Name = "DungeonBV"; bv.MaxForce = Vector3.new(9e9, 9e9, 9e9); bv.Velocity = Vector3.new(0,0,0)
        end
        TS:Create(Root, TweenInfo.new(Distance/_G.TweenSpeed, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

-- [[ CẤT KHO ]]
local function StoreAction()
    pcall(function()
        if IsInRaid() then return end
        local char = LP.Character
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                char.Humanoid:EquipTool(tool)
            end
        end
        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            Remote:InvokeServer("StoreFruit", toolOnHand.Name:gsub(" Fruit", ""), toolOnHand)
        end
    end)
end
task.spawn(function() while task.wait(0.5) do StoreAction() end end)

