-- [[ CHECK ĐẢO RAID ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then 
        for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end 
    end
    return nil
end

