-- [[ HÀM GỬI DISCORD ]]
local function SendDiscord(fruitName)
    if getgenv().Webhook and getgenv().Webhook ~= "" and getgenv().Webhook ~= "LINK_WEBHOOK_CỦA_BẠN_Ở_ĐÂY" then
        local headers = {["Content-Type"] = "application/json"}
        local data = {
            ["embeds"] = {{
                ["title"] = "🍎 FRUIT NOTIFICATION",
                ["description"] = "Đã tìm thấy và cất kho: **" .. fruitName .. "**",
                ["color"] = 65280, -- Màu xanh lá
                ["footer"] = {["text"] = "Gemini Auto Hop - " .. os.date("%X")}
            }}
        }
        local body = Http:JSONEncode(data)
        -- Sử dụng request của executor (Hầu hết các bản hack đều hỗ trợ hàm này)
        local request = syn and syn.request or http_request or request or HttpPost
        if request then
            request({Url = getgenv().Webhook, Method = "POST", Headers = headers, Body = body})
        end
    end
end

