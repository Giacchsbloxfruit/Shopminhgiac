-- [[ 3. AUTO MUA CHIP & VÀO RAID (CHỈ LÀM RAID MÌNH) ]]
-- ========================================================
task.spawn(function()
    while task.wait(1) do
        local inRaid = IsInRaid()
        local chipTool = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))

        if not inRaid then
            if RaidEndTime == 0 then RaidEndTime = tick() end
            local canBuy = (tick() - ScriptStartedTime > 10) and (tick() - LastGrabTime > 5) and (tick() - RaidEndTime > 5)

            -- Chỉ mua chip nếu túi chưa có chip/trái và đủ thời gian chờ
            if _G.AutoBuyChip and not CheckFull() and not BoughtChip and canBuy then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
                BoughtChip = true
            end

            -- CHỐNG RAID NGƯỜI KHÁC: Chỉ bay tới bảng điều khiển nếu CHÍNH MÌNH cầm Chip
            if chipTool then
                local RaidControlPos = CFrame.new(-6438.73, 250.64, -4501.5)
                topos_tween(RaidControlPos)
                
                if (LP.Character.HumanoidRootPart.Position - RaidControlPos.Position).Magnitude < 15 then
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then 
                        fireclickdetector(RaidBtn.ClickDetector) 
                    end
                end
            end
        else
            BoughtChip = false 
            RaidEndTime = tick()
        end
    end
end)

-- ========================================================
-- [[ 4. LOGIC AUTO HOP (CHECK TÚI TRỐNG 15S) ]]
-- ========================================================
task.spawn(function()
    local counter = 0
    task.wait(10) -- Chờ 10s đầu ổn định
    while task.wait(1) do
        if _G.AutoHop and not IsInRaid() then
            if CheckFull() then
                counter = 0 
            else
                counter = counter + 1
                if counter >= 15 then
                    Notify("Túi trống 15s. Đang đổi Server...")
                    pcall(function()
                        local servers = game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100")).data
                        for _, s in pairs(servers) do
                            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                                game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, s.id, LP)
                                break
                            end
                        end
                    end)
                    counter = 0
                end
            end
        else
            counter = 0
        end
    end
end)

