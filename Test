-- [[ 4. HÀM HOP SERVER SIÊU TỐC ]]
local function HopServer()
    statusLabel.Text = "Đang đổi Server..."
    task.spawn(function()
        while task.wait(0.1) do GuiService:ClearError() end
    end)
    local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
    pcall(function()
        local Raw = game:HttpGet(Api)
        local Decode = Http:JSONDecode(Raw)
        for _, v in pairs(Decode.data) do
            if v.playing < v.maxPlayers and v.id ~= game.JobId then
                TPS:TeleportToPlaceInstance(game.PlaceId, v.id, LP)
                task.wait(1)
            end
        end
    end)
end

-- [[ 5. HÀM THÔNG BÁO DISCORD ]]
local function SendDiscord(fruitName)
    if getgenv().Webhook and getgenv().Webhook ~= "" then
        pcall(function()
            local data = {["embeds"] = {{["title"] = "🍎 NHẬT ĐƯỢC TRÁI", ["description"] = "Đã cất thành công: **" .. fruitName .. "**", ["color"] = 65280}}}
            local request = syn and syn.request or http_request or request or HttpPost
            if request then request({Url = getgenv().Webhook, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = Http:JSONEncode(data)}) end
        end)
    end
end

-- [[ 6. HÀM CẤT KHO (Sử dụng code bạn yêu cầu) ]]
local function StoreAction()
    pcall(function()
        local char = LP.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local remote = GetCommF()
        
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                hum:EquipTool(tool)
                task.wait(0.2)
            end
        end

        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            
            -- Gửi thông báo Discord trước khi cất
            SendDiscord(toolOnHand.Name)

            task.defer(function()
                if remote then
                    remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", fruitName.."-"..fruitName, toolOnHand)
                    remote:InvokeServer("StoreFruit", toolOnHand.Name, toolOnHand)
                end
            end)
            statusLabel.Text = "Đã cất: " .. fruitName
            task.wait(1) 
            HopServer() -- Nhặt được và cất rồi thì đổi server luôn
        end
    end)
end

-- [[ 7. VÒNG LẶP CHÍNH ]]
local countdown = 15
local grabAttempt = 0 -- Đếm thời gian đứng tại trái

task.spawn(function()
    while task.wait(1) do
        local fruit = nil
        for _, v in pairs(game.Workspace:GetChildren()) do
            if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then
                fruit = v
                break
            end
        end

        if fruit then
            -- NẾU CÓ TRÁI: Dừng đếm ngược, hiện trạng thái nhặt
            countdown = 15 
            timerLabel.Visible = false
            statusLabel.Text = "Đang nhặt: " .. fruit.Name
            statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
            
            if getgenv().Grabfruit then
                -- Bay tới trái
                LP.Character.HumanoidRootPart.CFrame = fruit.Handle.CFrame
                -- ÉP CHẠM (Giải kẹt - firetouchinterest)
                firetouchinterest(LP.Character.HumanoidRootPart, fruit.Handle, 0)
                firetouchinterest(LP.Character.HumanoidRootPart, fruit.Handle, 1)
            end

            -- Chạy lệnh cất kho
            StoreAction()

            -- Tự giải kẹt: Nếu đứng tại trái 5 giây mà chưa nhặt được thì Hop luôn
            grabAttempt = grabAttempt + 1
            if grabAttempt >= 5 then
                HopServer()
            end
        else
            -- NẾU KHÔNG CÓ TRÁI
            grabAttempt = 0
            statusLabel.Text = "Không có trái ác quỷ"
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            timerLabel.Visible = true
            timerLabel.Text = "Hop sever : " .. countdown .. "s"
            
            countdown = countdown - 1
            if countdown <= 0 then
                HopServer()
                countdown = 15
            end
        end
    end
end)
