    })
end

-- [[ HÀM TWEEN 200 ]]
local function topos_tween(Pos)
    pcall(function()
        local Root = LP.Character:FindFirstChild("HumanoidRootPart")
        if not Root then return end
        local Distance = (Pos.Position - Root.Position).Magnitude
        
        if Distance < 5 then 
            if Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
            return 
        end 

        if not Root:FindFirstChild("DungeonBV") then
            local bv = Instance.new("BodyVelocity", Root)
            bv.Name = "DungeonBV"; bv.Velocity = Vector3.new(0,0,0); bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        end
        TS:Create(Root, TweenInfo.new(Distance/200, Enum.EasingStyle.Linear), {CFrame = Pos}):Play()
    end)
end

local function topos_fast(Pos)
    pcall(function() if LP.Character:FindFirstChild("HumanoidRootPart") then LP.Character.HumanoidRootPart.CFrame = Pos end end)
end

