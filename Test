-- [[ 6. COMPLETE RAID ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if (v.HumanoidRootPart.Position - island.Position).Magnitude < 1000 then
                            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist = d; target = v end
                        end
                    end
                end
                if target then
                    if not LP.Character:FindFirstChildOfClass("Tool") or LP.Character:FindFirstChildOfClass("Tool").ToolTip ~= "Melee" then
                        for _, t in pairs(LP.Backpack:GetChildren()) do if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) break end end
                    end
                    topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                else
                    topos_tween(island.CFrame * CFrame.new(0, 70, 0))
                end
            end)
        else
            local Root = LP.Character:FindFirstChild("HumanoidRootPart")
            if Root and Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
        end
    end
end)

-- [[ 7. HOP SERVER AN TOÀN ]]
function ForceHop()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local PlaceId = game.PlaceId
    pcall(function()
        local result = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
        for _, s in pairs(result.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LP)
                task.wait(2)
            end
        end
    end)
end

task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Special Microchip")
            local hasFruitOnMe = HasItem("Fruit")

            -- Điều kiện Hop: Không Raid, Không Chip trên người, Không cầm trái trên tay
            if not inRaid and not hasChip and not hasFruitOnMe then
                waitTime = waitTime - 1
                if waitTime == 10 then Notify("Túi sạch! Đổi Server sau 10s")
                elseif waitTime <= 0 then
                    Notify("Đang đổi Server...")
                    ForceHop()
                    waitTime = 15
                end
            else
                waitTime = 15 -- Reset nếu đang bận
            end
        end
    end
end)

