-- [[ COMPLETE RAID - CHỈ CHẠY KHI CÓ TIMER ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end end
    return nil
end

task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island and IsInRaid() then -- THÊM CHECK TIMER Ở ĐÂY
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if (v.HumanoidRootPart.Position - island.Position).Magnitude < 800 then
                            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist = d; target = v end
                        end
                    end
                end
                
                if not LP.Character:FindFirstChildOfClass("Tool") or (LP.Character:FindFirstChildOfClass("Tool") and LP.Character:FindFirstChildOfClass("Tool").ToolTip ~= _G.SelectWeapon) then
                    for _, t in pairs(LP.Backpack:GetChildren()) do if t.ToolTip == _G.SelectWeapon then LP.Character.Humanoid:EquipTool(t) end end
                end

                if target then
                    topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                else
                    topos_tween(island.CFrame * CFrame.new(0, 60, 0))
                end
            end)
        end
    end
end)

-- [[ HOP SERVER FIX - KHÔNG CÓ TRÁI LÀ CÚT ]]
local function ForceDeepHop()
    Notify("Đang tìm Server mới...")
    local PlaceId = game.PlaceId
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local function GetList(cursor)
        local s, r = pcall(function() return game:HttpGet(url .. (cursor and "&cursor=" .. cursor or "")) end)
        return s and HttpService:JSONDecode(r) or nil
    end
    local data = GetList()
    for i = 1, math.random(2, 4) do if data and data.nextPageCursor then data = GetList(data.nextPageCursor) end end
    if data and data.data then
        for i = #data.data, 1, -1 do
            local s = data.data[i]
            if s.id ~= game.JobId and s.playing < s.maxPlayers - 1 then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LP)
                return
            end
        end
    end
    TeleportService:Teleport(PlaceId, LP)
end

