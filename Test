-- [[ 6. COMPLETE RAID (FARM FRAG) ]]
local function GetCurrentIsland()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    if loc then for i=5,1,-1 do if loc:FindFirstChild("Island "..i) then return loc:FindFirstChild("Island "..i) end end end
    return nil
end

task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if (v.HumanoidRootPart.Position - island.Position).Magnitude < 800 then
                            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist = d; target = v end
                        end
                    end
                end
                if target then
                    -- Trang bị vũ khí
                    if not LP.Character:FindFirstChildOfClass("Tool") then
                        for _, t in pairs(LP.Backpack:GetChildren()) do if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) end end
                    end
                    topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                else
                    topos_tween(island.CFrame * CFrame.new(0, 60, 0))
                end
            end)
        end
    end
end)

-- [[ 7. HOP SERVER LIÊN TỤC CHECK ]]
function HopServer()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local PlaceId = game.PlaceId
    pcall(function()
        local result = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
        for _, s in pairs(result.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LP)
                task.wait(2)
            end
        end
    end)
end

task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = HasItem("Special Microchip")
            local hasFruitOnMe = HasItem("Fruit")

            -- Điều kiện đếm ngược Hop: KHÔNG Raid, KHÔNG Chip, KHÔNG Trái
            if not inRaid and not hasChip and not hasFruitOnMe then
                waitTime = waitTime - 1
                
                -- Thông báo quá trình check & hop cho khỏi chán
                if waitTime == 10 then 
                    Notify("Đang kiểm tra... 10s nữa Hop Server")
                elseif waitTime == 5 then 
                    Notify("Check OK! Chuẩn bị nhảy Server: 5s")
                elseif waitTime <= 0 then
                    Notify("Hopping...")
                    HopServer()
                    waitTime = 15 -- Set lại phòng trường hợp nhảy xịt
                end
            else
                waitTime = 15 -- Reset nếu đột nhiên vớ được trái, mua được chip, hoặc đang raid
            end
        end
    end
end)

