                        if (LP.Character.HumanoidRootPart.Position - Sea2_Pos.Position).Magnitude < 15 then
                            task.wait(0.5)
                            Remote:InvokeServer("SetSpawnPoint")
                            local RaidButton = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                            if RaidButton then
                                LP.Character.HumanoidRootPart.CFrame = RaidButton.CFrame
