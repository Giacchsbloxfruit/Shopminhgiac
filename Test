-- [[ 6. COMPLETE RAID - ƯU TIÊN SỐ 1 ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 and v:FindFirstChild("HumanoidRootPart") then
                        if (v.HumanoidRootPart.Position - island.Position).Magnitude < 800 then
                            local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then dist = d; target = v end
                        end
                    end
                end
                if target then
                    if not LP.Character:FindFirstChildOfClass("Tool") or LP.Character:FindFirstChildOfClass("Tool").ToolTip ~= "Melee" then
                        for _, t in pairs(LP.Backpack:GetChildren()) do if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) break end end
                    end
                    topos_tween(target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                else
                    topos_tween(island.CFrame * CFrame.new(0, 60, 0))
                end
            end)
        else
            local Root = LP.Character:FindFirstChild("HumanoidRootPart")
            if Root and Root:FindFirstChild("DungeonBV") then Root.DungeonBV:Destroy() end
        end
    end
end)

-- [[ 7. FIX HOP SERVER (5S CHECK + 10S HOP) ]]
function HopServer()
    local TeleportService = game:GetService("TeleportService")
    local HttpService = game:GetService("HttpService")
    local PlaceId = game.PlaceId
    pcall(function()
        local Servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
        for _, s in pairs(Servers.data) do
            if s.playing < s.maxPlayers and s.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LP)
                return
            end
        end
    end)
end

task.spawn(function()
    local waitTime = 15
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            if not inRaid and not HasItem("Microchip") and not HasItem("Fruit") then
                waitTime = waitTime - 1
                if waitTime == 14 then Notify("Backpack Clear! Waiting 5s...")
                elseif waitTime == 10 then Notify("Server Hop in 10s...")
                elseif waitTime == 5 then Notify("Server Hop in 5s...")
                elseif waitTime <= 0 then
                    Notify("Searching Server...")
                    HopServer()
                    waitTime = 10 -- Đợi 10s để hệ thống phản hồi
                end
            else
                if waitTime < 15 then Notify("Hop Cancelled!"); waitTime = 15 end
            end
        end
    end
end)

