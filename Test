end)

-- [[ 3. ÉP LỆNH CẤT KHO ]]
local function StoreAction()
    local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
    if inRaid then return end
    pcall(function()
        local char = LP.Character
        for _, tool in pairs(LP.Backpack:GetChildren()) do
            if tool:IsA("Tool") and (tool.ToolTip == "Fruit" or string.find(tool.Name, "Fruit")) then
                char.Humanoid:EquipTool(tool)
                task.wait(0.2)
            end
        end
        local toolOnHand = char:FindFirstChildOfClass("Tool")
        if toolOnHand and (toolOnHand.ToolTip == "Fruit" or string.find(toolOnHand.Name, "Fruit")) then
            local fruitName = toolOnHand.Name:gsub(" Fruit", "")
            task.defer(function()
                Remote:InvokeServer("StoreFruit", fruitName, toolOnHand)
                Remote:InvokeServer("StoreFruit", fruitName.."-"..fruitName, toolOnHand)
                Remote:InvokeServer("StoreFruit", toolOnHand.Name, toolOnHand)
            end)
            task.wait(1) 
        end
    end)
end
task.spawn(function() while task.wait(0.5) do StoreAction() end end)

-- [[ 4 & 5. MUA CHIP & START RAID ]]
task.spawn(function()
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
        if not inRaid and (tick() - LastGrabTime) > 5 then
            local hasChip = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            if _G.AutoBuyChip and not hasChip then
                Remote:InvokeServer("RaidsNpc", "Select", _G.SelectChip)
            end
            if _G.StartRaid and hasChip then
                local Sea2_Pos = CFrame.new(-6438.73, 250.64, -4501.5)
                if (LP.Character.HumanoidRootPart.Position - Sea2_Pos.Position).Magnitude > 10 then
                    -- Di chuyển tới chỗ Start Raid
                    LP.Character.HumanoidRootPart.CFrame = Sea2_Pos
                else
                    Remote:InvokeServer("SetSpawnPoint")
                    local RaidBtn = workspace.Map:FindFirstChild("CircleIsland") and workspace.Map.CircleIsland.RaidSummon2.Button.Main
                    if RaidBtn then
                        LP.Character.HumanoidRootPart.CFrame = RaidBtn.CFrame
                        fireclickdetector(RaidBtn.ClickDetector)
                    end
                end
            end
        end
    end
end)

-- [[ 6. ĐÁNH RAID ]]
task.spawn(function()
    while task.wait(0.1) do
        local island = GetCurrentIsland()
        if _G.Dungeon and island then
            pcall(function()
                local target, dist = nil, math.huge
                for _, v in pairs(workspace.Enemies:GetChildren()) do
                    if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                        local d = (v.HumanoidRootPart.Position - LP.Character.HumanoidRootPart.Position).Magnitude
                        if d < dist then dist = d; target = v end
                    end
                end
                if target then
                    if not LP.Character:FindFirstChildOfClass("Tool") then
                        for _, t in pairs(LP.Backpack:GetChildren()) do if t.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(t) end end
                    end
                    LP.Character.HumanoidRootPart.CFrame = target.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0)
                else
                    LP.Character.HumanoidRootPart.CFrame = island.CFrame * CFrame.new(0, 60, 0)
                end
            end)
        end
    end
end)

-- [[ 7. HOP SERVER AN TOÀN ]]
function SafeHop()
    local HttpService = game:GetService("HttpService")
    local TeleportService = game:GetService("TeleportService")
    local PlaceId = game.PlaceId
    pcall(function()
        local result = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..PlaceId.."/servers/Public?sortOrder=Asc&limit=100"))
        for _, s in pairs(result.data) do
            if s.id ~= game.JobId and s.playing < s.maxPlayers then
                TeleportService:TeleportToPlaceInstance(PlaceId, s.id, LP)
                break
            end
        end
    end)
end

task.spawn(function()
    local waitTime = 20 -- Đợi 20 giây túi sạch mới nhảy
    while task.wait(1) do
        if _G.AutoHop then
            local inRaid = LP.PlayerGui.Main.Timer.Visible or GetCurrentIsland()
            local hasChip = LP.Backpack:FindFirstChild("Special Microchip") or (LP.Character and LP.Character:FindFirstChild("Special Microchip"))
            local hasFruit = false
            for _, v in pairs(LP.Backpack:GetChildren()) do
                if v:IsA("Tool") and (v.ToolTip == "Fruit" or string.find(v.Name, "Fruit")) then hasFruit = true break end
            end

            -- CHỈ HOP KHI: Không Raid, Không Chip, Không Trái
            if not inRaid and not hasChip and not hasFruit then
                waitTime = waitTime - 1
                if waitTime == 10 then Notify("Túi trống! Sẽ đổi Server sau 10s")
                elseif waitTime <= 0 then
                    Notify("Đang nhảy Server...")
                    SafeHop()
                    waitTime = 20
                end
            else
                -- Nếu đang đánh Raid hoặc có Chip, reset thời gian chờ ngay lập tức
                if waitTime < 20 then
                    waitTime = 20
                    Notify("Đã hủy Hop: Đang thực hiện nhiệm vụ!")
                end
            end
        end
    end
end)

