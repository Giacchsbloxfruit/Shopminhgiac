_G.AutoAttack = true

local Net = game:GetService("ReplicatedStorage").Modules.Net
local Player = game.Players.LocalPlayer

task.spawn(function()
    while _G.AutoAttack do
        -- Thay vì 0.1 cố định, dùng math.random để tạo nhịp đánh tự nhiên hơn
        task.wait(math.random(8, 12) / 100) 
        
        pcall(function()
            local char = Player.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            -- Chỉ chạy tiếp nếu đang cầm vũ khí (Tool)
            if not (char and root and char:FindFirstChildOfClass("Tool")) then return end

            for _, e in pairs(workspace.Enemies:GetChildren()) do
                local eRoot = e:FindFirstChild("HumanoidRootPart")
                if eRoot and e.Humanoid.Health > 0 then
                    -- Kiểm tra khoảng cách (Rút xuống 60 để an toàn hơn)
                    if (root.Position - eRoot.Position).Magnitude <= 60 then
                        Net["RE/RegisterAttack"]:FireServer()
                        Net["RE/RegisterHit"]:FireServer(eRoot, {eRoot})
                        -- Thêm break nếu bạn chỉ muốn đánh 1 con quái 1 lúc để đỡ lag/giảm spam
                        -- break 
                    end
                end
            end
        end)
    end
end)
