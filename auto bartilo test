-- ========================================================
-- [[ THIẾT LẬP AUTO BARTILO QUEST ]]
-- ========================================================
_G.AutoBartilo = true 
getgenv().TweenSpeed = 250 -- Tốc độ bay

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local TS = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")

local plr = Players.LocalPlayer
local CommF = RS:WaitForChild("Remotes"):WaitForChild("CommF_")

-- ========================================================
-- [[ HỆ THỐNG NOCLIP & VELOCITY (CHỐNG RƠI) ]]
-- ========================================================
RunService.Stepped:Connect(function()
    if _G.AutoBartilo and plr.Character then
        -- Noclip (Xuyên tường)
        for _, v in pairs(plr.Character:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
        
        -- Chống rơi (Giữ nhân vật lơ lửng trên không)
        local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", hrp)
            bv.Name = "AntiFall"
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.zero
        end
    end
end)

-- ========================================================
-- [[ HÀM TWEEN (BAY MƯỢT) ]]
-- ========================================================
local function TweenTo(targetCFrame)
    local char = plr.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = char.HumanoidRootPart
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local timeToTravel = dist / getgenv().TweenSpeed
    
    local tween = TS:Create(hrp, TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    tween:Play()
    
    if dist <= 5 then
        tween:Cancel()
        hrp.CFrame = targetCFrame
        return true
    end
    return false
end

-- ========================================================
-- [[ HÀM TÌM QUÁI & AUTO CLICK ]]
-- ========================================================
local function GetEnemy(name)
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        if v.Name == name and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            return v
        end
    end
    return nil
end

local function AutoAttack(target)
    if not target or not target:FindFirstChild("HumanoidRootPart") then return end
    
    -- Bay lên trên đầu quái
    TweenTo(target.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0))
    
    -- Tự động cầm Melee
    pcall(function()
        for _, tool in pairs(plr.Backpack:GetChildren()) do
            if tool.ToolTip == "Melee" or tool.ToolTip == "Sword" then
                plr.Character.Humanoid:EquipTool(tool)
            end
        end
    end)
    
    -- Tự động Click (Đánh)
    VirtualUser:CaptureController()
    VirtualUser:Button1Down(Vector2.new(0, 0))
    
    -- Skill/Hit Remote (Fast Attack)
    pcall(function()
        RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
        RS.Modules.Net["RE/RegisterHit"]:FireServer(target.PrimaryPart, {{target, target.PrimaryPart}})
    end)
end

-- ========================================================
-- [[ VÒNG LẶP AUTO BARTILO QUEST ]]
-- ========================================================
task.spawn(function()
    while task.wait(0.1) do
        if not _G.AutoBartilo then 
            -- Tắt Velocity khi ngưng Auto
            pcall(function() plr.Character.HumanoidRootPart.AntiFall:Destroy() end)
            break 
        end
        
        pcall(function()
            local Level = plr.Data.Level.Value
            if Level < 850 then 
                print("Chưa đủ cấp độ (Yêu cầu Lv 850+)")
                task.wait(2)
                return 
            end
            
            local Progress = CommF:InvokeServer("BartiloQuestProgress", "Bartilo")
            local QuestGui = plr.PlayerGui.Main:FindFirstChild("Quest")
            
            -- BƯỚC 1: GIẾT 50 SWAN PIRATES
            if Progress == 0 then
                if QuestGui and QuestGui.Visible then
                    if string.find(QuestGui.Container.QuestTitle.Title.Text, "Swan Pirate") then
                        local target = GetEnemy("Swan Pirate")
                        if target then
                            AutoAttack(target)
                        else
                            TweenTo(CFrame.new(970.36, 142.65, 1217.36)) -- Bãi Swan Pirate
                        end
                    else
                        CommF:InvokeServer("AbandonQuest") -- Hủy nếu nhận sai quest
                    end
                else
                    local BartiloNPC = CFrame.new(-461.53, 72.34, 300.31)
                    if (plr.Character.HumanoidRootPart.Position - BartiloNPC.Position).Magnitude > 10 then
                        TweenTo(BartiloNPC)
                    else
                        CommF:InvokeServer("StartQuest", "BartiloQuest", 1)
                    end
                end
                
            -- BƯỚC 2: GIẾT BOSS JEREMY
            elseif Progress == 1 then
                local Jeremy = GetEnemy("Jeremy")
                if Jeremy then
                    AutoAttack(Jeremy)
                else
                    TweenTo(CFrame.new(2158.97, 449.05, 705.41)) -- Núi của Jeremy
                end
                
            -- BƯỚC 3: GIẢI MÃ BÀN ĐẠP COLOSSEUM
            elseif Progress == 2 then
                local ColosseumPos = CFrame.new(-1830.83, 10.55, 1680.60)
                if (plr.Character.HumanoidRootPart.Position - ColosseumPos.Position).Magnitude > 30 then
                    TweenTo(ColosseumPos)
                else
                    -- Lướt qua 8 Plate
                    local plates = workspace.Map.Dressrosa.BartiloPlates
                    local delayPlate = 0.5
                    
                    for i = 1, 8 do
                        plr.Character.HumanoidRootPart.CFrame = plates["Plate"..i].CFrame
                        task.wait(delayPlate)
                    end
                    task.wait(2)
                end
                
            -- HOÀN THÀNH
            elseif Progress >= 3 then
                print("Đã hoàn thành Quest Bartilo!")
                pcall(function() plr.Character.HumanoidRootPart.AntiFall:Destroy() end)
                _G.AutoBartilo = false
            end
        end)
    end
end)

-- Bật thông báo
pcall(function()
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Auto Bartilo",
        Text = "Đang kiểm tra và chạy nhiệm vụ!",
        Duration = 5
    })
end)
