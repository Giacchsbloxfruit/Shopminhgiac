-- [[ Giacdz Hub | Tool lấy tọa độ XYZ ]]
local LP = game.Players.LocalPlayer
local Root = LP.Character.HumanoidRootPart
local Pos = Root.Position

-- Làm tròn số cho đẹp (không bị lẻ quá nhiều số thập phân)
local X = math.floor(Pos.X * 100) / 100
local Y = math.floor(Pos.Y * 100) / 100
local Z = math.floor(Pos.Z * 100) / 100

-- Tạo chuỗi tọa độ định dạng CFrame
local FormatCFrame = "CFrame.new(" .. X .. ", " .. Y .. ", " .. Z .. ")"

-- In ra màn hình console (Nhấn F9 để xem)
print("--------------------------------------")
print("Vị trí hiện tại của bạn:")
print("X: " .. X .. " | Y: " .. Y .. " | Z: " .. Z)
print("Định dạng Script: " .. FormatCFrame)
print("--------------------------------------")

-- Tự động Copy vào Clipboard (Chỉ hoạt động trên các Executor xịn như Fluxus, Delta, Wave, v.v.)
if setclipboard then
    setclipboard(FormatCFrame)
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "⚡ Giacdz Hub ⚡",
        Text = "Đã copy tọa độ vào Clipboard!",
        Duration = 3
    })
else
    warn("Executor của bạn không hỗ trợ lệnh Copy!")
end
