-- [[ HÀM SIÊU CẤP HOP - LẤY SERVER CŨ & CỰC CŨ ]]
local function ForceDeepHop()
    Notify("Có cái nịt. Đang tìm Server")
    local PlaceId = game.PlaceId
    local JobId = game.JobId
    local url = "https://games.roblox.com/v1/games/" .. PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    
    local function GetServerList(cursor)
        local success, result = pcall(function()
            return game:HttpGet(url .. (cursor and "&cursor=" .. cursor or ""))
        end)
        return success and HttpService:JSONDecode(result) or nil
    end

    local data = GetServerList()
    -- Nhảy ngẫu nhiên sâu vào danh sách trang (tới trang 3 hoặc 4 để tìm sv cũ)
    for i = 1, math.random(2, 4) do
        if data and data.nextPageCursor then
            data = GetServerList(data.nextPageCursor)
        end
    end

    if data and data.data then
        local possibleServers = {}
        for _, s in pairs(data.data) do
            if s.id ~= JobId and s.playing < s.maxPlayers - 1 then
                table.insert(possibleServers, s.id)
            end
        end

        if #possibleServers > 0 then
            -- Chọn server ở cuối danh sách trang đó (thường là sv cũ hơn)
            local randomTarget = possibleServers[math.random(math.floor(#possibleServers/2), #possibleServers)]
            Notify("Đang hop Server mới!...")
            task.wait(0.5)
            TeleportService:TeleportToPlaceInstance(PlaceId, randomTarget, LP)
        else
            Notify("Không tìm thấy Server, hop random...")
            TeleportService:Teleport(PlaceId, LP) -- Fallback nhảy đại
        end
    else
        Notify("Lỗi API Roblox, đang nhảy server ngẫu nhiên...")
        TeleportService:Teleport(PlaceId, LP)
    end
end

-- [[ LOGIC AUTO CHECK & HOP (SAU 10S BẬT) ]]
task.spawn(function()
    local counter = 0
    task.wait(10) -- Chờ 10s ổn định theo ý bro
    Notify("Script Loading - 10s")
    
    while task.wait(1) do
        local inRaid = LP.PlayerGui.Main.Timer.Visible
        if not inRaid then
            if CheckFull() then
                if counter > 0 then Notify("Có đồ! Đã hủy Hop.") end
                counter = 0
            else
                counter = counter + 1
                if counter == 5 then 
                    Notify("Check túi - 5s")
                elseif counter >= 15 then
                    ForceDeepHop()
                    counter = 0 -- Reset counter để tránh spam nếu hop fail
                    task.wait(5) -- Chờ thêm trước khi thử lại
                end
            end
        else
            counter = 0
        end
    end
end)

