            end
            return
        end
    end

    -- Fallback cho Level cao nhất Sea 2
    if myLv >= 1475 then
        NameQuest, LevelQuest, NameMon = "ForgottenQuest", 2, "Water Fighter"
        CFrameQuest = CFrame.new(-3054.4, 239.5, -10142.8)
        CFrameMon = CFrame.new(-3335.5, 239.5, -10549.5)
