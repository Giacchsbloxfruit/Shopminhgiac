-- [[ 5. MODULE TWEEN VÀ CỐ ĐỊNH NHÂN VẬT ]]
-- ========================================================
local function TweenTo(targetPos)
    local char = LP.Character or LP.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local dist = (root.Position - targetPos.Position).Magnitude
    
    local myZ, targetZ = root.Position.Z, targetPos.Z
    if myZ > 20000 and targetZ < 20000 then
        pcall(function()
            GetCommF():InvokeServer("requestEntrance", Vector3.new(923.21252441406, 126.9760055542, 32852.83203125))
            task.wait(0.1)
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame * CFrame.new(0, 0, -10) 
            end
        end)
        task.wait(0.5); return false
    elseif myZ < 20000 and targetZ > 20000 then
        pcall(function() GetCommF():InvokeServer("requestEntrance", Vector3.new(923.21252441406, 126.9760055542, 32852.83203125)) end)
        task.wait(0.5); return false
    end
    
    local bv = root:FindFirstChild("AntiFall") or Instance.new("BodyVelocity", root)
    bv.Name = "AntiFall"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero

    if dist > 15 then 
        TS:Create(root, TweenInfo.new(dist/getgenv().TweenSpeed, Enum.EasingStyle.Linear), {CFrame = targetPos}):Play()
        return false
    else
        root.CFrame = targetPos
        return true
    end
end

