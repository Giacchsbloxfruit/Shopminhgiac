local NameQuest, LevelQuest, NameMon, CFrameQuest, CFrameMon = "", 1, "", nil, nil

function CheckQuest()
    local myLv = LP.Data.Level.Value
    for _, v in pairs(QuestList) do
        if myLv >= v.Min and myLv <= v.Max then
            NameQuest, LevelQuest, NameMon, CFrameQuest, CFrameMon = v.Name, v.Lv, v.Mon, v.NPC, v.MonPos
            return
        end
    end
    -- Fallback nếu Max Level
    if myLv >= 1475 then
        NameQuest, LevelQuest, NameMon = "ForgottenQuest", 2, "Water Fighter"
        CFrameQuest = CFrame.new(-3054.4, 239.5, -10142.8)
        CFrameMon = CFrame.new(-3335.5, 239.5, -10549.5)
    end
end

function EquipMelee()
    pcall(function()
        for _, v in pairs(LP.Backpack:GetChildren()) do
            if v.ToolTip == "Melee" then LP.Character.Humanoid:EquipTool(v); break end
        end
    end)
end

function IsQuestActive()
    local qGui = LP.PlayerGui.Main:FindFirstChild("Quest")
    return qGui and qGui.Visible and string.find(qGui.Container.QuestTitle.Title.Text, NameMon)
end

