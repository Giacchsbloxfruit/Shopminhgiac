local function GetMeleeData()
    local name, mas = "None", 0
    local sources = {LP.Backpack, LP.Character}
    for _, source in pairs(sources) do
        if source then
            for _, v in pairs(source:GetChildren()) do
                if v:IsA("Tool") and v.ToolTip == "Melee" then
                    name = v.Name
                    if v:FindFirstChild("Level") then mas = v.Level.Value end
                    return name, mas -- Ưu tiên lấy Melee đang có
                end
            end
        end
    end
    return name, mas
end

