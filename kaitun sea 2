-- ========================================================
task.spawn(function()
    while task.wait() do
        if _G.GoingToSea3 or _G.StopFarmForMelee then task.wait(1); continue end
        pcall(function()
            if _G.Grabfruit then
                local fruit = nil
                for _, v in pairs(workspace:GetChildren()) do
                    if string.find(v.Name, "Fruit") and v:FindFirstChild("Handle") then fruit = v; break end
                end
                if fruit then TweenTo(fruit.Handle.CFrame); return end
            end
            
            CheckQuest()
            if not CFrameQuest then return end -- Đề phòng chưa load Quest
            
            if not IsQuestActive() then
                if TweenTo(CFrameQuest) then GetCommF():InvokeServer("StartQuest", NameQuest, LevelQuest) end
            else
                local Enemy = nil
                for _, e in pairs(workspace.Enemies:GetChildren()) do
                    if e.Name == NameMon and e:FindFirstChild("Humanoid") and e.Humanoid.Health > 0 then 
                        Enemy = e; break 
                    end
                end
                
                if Enemy then
                    EquipMelee()
                    TweenTo(Enemy.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0))
                    RS.Modules.Net["RE/RegisterAttack"]:FireServer(0)
                    RS.Modules.Net["RE/RegisterHit"]:FireServer(Enemy.PrimaryPart, {{Enemy, Enemy.PrimaryPart}})
                else
                    TweenTo(CFrameMon)
                end
            end
        end)
    end
end)

