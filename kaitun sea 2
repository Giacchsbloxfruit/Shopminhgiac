local function GetMeleeData()
    local meleeName, meleeMas = "Combat", 0
    pcall(function()
        local tool = nil
        for _, v in pairs(LP.Backpack:GetChildren()) do if v:IsA("Tool") and v.ToolTip == "Melee" then tool = v; break end end
        if not tool and LP.Character then
            for _, v in pairs(LP.Character:GetChildren()) do if v:IsA("Tool") and v.ToolTip == "Melee" then tool = v; break end end
        end
        if tool then
            meleeName = tool.Name
            if tool:FindFirstChild("Level") then meleeMas = tool.Level.Value end
        end
    end)
    return meleeName, meleeMas
end

