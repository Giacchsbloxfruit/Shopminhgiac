    local myLv = LP.Data.Level.Value
    CFrameQuest = nil -- Reset để tránh lỗi tọa độ cũ
    
    for _, v in pairs(QuestList) do
        if myLv >= v.Min and myLv <= v.Max then
            NameQuest, LevelQuest, NameMon, CFrameQuest, CFrameMon = v.Name, v.Lv, v.Mon, v.NPC, v.MonPos
            
            -- Tối ưu: Tự động xin vào cửa nếu khoảng cách quá xa (áp dụng cho Tàu Ma)
